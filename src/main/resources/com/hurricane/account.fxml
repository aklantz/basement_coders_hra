<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.layout.*?>
<?import javafx.scene.control.*?>
<?import javafx.geometry.Insets?>

<StackPane fx:id="accountRoot"
           xmlns="http://javafx.com/javafx/13"
           xmlns:fx="http://javafx.com/fxml/1"
           fx:controller="com.controllers.AccountController"
           prefWidth="390"
           prefHeight="800"
           focusTraversable="true"
           style="-fx-background-color: #F4F7FA;
                  -fx-font-family: 'Segoe UI';
                  -fx-font-size: 14px;
                  -fx-accent: #008681;
                  -fx-focus-color: #008681;">

    <BorderPane fx:id="mainContent">
        <center>
            <ScrollPane fx:id="pageScroll"
                        fitToWidth="true"
                        hbarPolicy="NEVER"
                        style="-fx-background: #F4F7FA;
                               -fx-background-color: #F4F7FA;
                               -fx-padding: 0;">
                <content>
                    <StackPane alignment="TOP_CENTER">
                        <VBox spacing="20"
                              minHeight="-Infinity"
                              maxWidth="390"
                              style="-fx-padding: 22px;">

                            <!-- Header -->
                            <HBox alignment="CENTER_LEFT">
                                <Label text="◉  Hurricane Tracker"
                                       style="-fx-font-size: 13px;
                                              -fx-text-fill: #008681;" />

                                <Region HBox.hgrow="ALWAYS" />

                                <Label fx:id="locationLabel"
                                       wrapText="true"
                                       minHeight="-Infinity"
                                       maxWidth="130"
                                       style="-fx-font-size: 11px;
                                              -fx-text-fill: #587083;" />
                            </HBox>

                            <Label text="Your account"
                                   wrapText="true"
                                   minHeight="-Infinity"
                                   style="-fx-font-size: 27px;
                                          -fx-font-weight: bold;
                                          -fx-text-fill: #142D45;" />

                            <Label text="Manage your household, contact details and preferences."
                                   wrapText="true"
                                   minHeight="-Infinity"
                                   maxWidth="Infinity"
                                   style="-fx-font-size: 13px;
                                          -fx-text-fill: #587083;" />

                            <Label fx:id="messageLabel"
                                   visible="false"
                                   managed="false"
                                   wrapText="true"
                                   minHeight="-Infinity"
                                   maxWidth="Infinity"
                                   style="-fx-font-size: 13px;
                                          -fx-text-fill: #008681;" />

                            <!-- Account card -->
                            <VBox spacing="9"
                                  minHeight="-Infinity"
                                  style="-fx-background-color: white; -fx-background-radius: 12px; -fx-border-color: #D8E3EB; -fx-border-radius: 12px; -fx-padding: 16px;">

                                <HBox alignment="CENTER_LEFT">
                                    <Label fx:id="nameLabel"
                                           text="Your name"
                                           wrapText="true"
                                           minHeight="-Infinity"
                                           style="-fx-font-size: 18px; -fx-font-weight: bold; -fx-text-fill: #142D45;" />

                                    <Region HBox.hgrow="ALWAYS" />

                                    <Hyperlink text="Edit"
                                               onAction="#editProfile"
                                               style="-fx-text-fill: #008681;" />
                                </HBox>

                                <Label fx:id="roleLabel"
                                       text="Resident account"
                                       wrapText="true"
                                       minHeight="-Infinity"
                                       style="-fx-font-size: 12px; -fx-text-fill: #587083;" />

                                <Label fx:id="emailLabel"
                                       wrapText="true"
                                       minHeight="-Infinity"
                                       maxWidth="Infinity"
                                       style="-fx-font-size: 13px; -fx-text-fill: #587083;" />

                                <Label fx:id="phoneLabel"
                                       wrapText="true"
                                       minHeight="-Infinity"
                                       style="-fx-font-size: 13px; -fx-text-fill: #587083;" />
                            </VBox>

                            <!-- Profile editor -->
                            <VBox fx:id="profilePanel"
                                  spacing="12"
                                  minHeight="-Infinity"
                                  visible="false"
                                  managed="false"
                                  style="-fx-background-color: white; -fx-background-radius: 12px; -fx-border-color: #D8E3EB; -fx-border-radius: 12px; -fx-padding: 16px;">

                                <VBox spacing="7">
                                    <Label text="Full name *"
                                           style="-fx-font-size: 12px; -fx-font-weight: bold; -fx-text-fill: #142D45;" />

                                    <TextField fx:id="nameField"
                                               style="-fx-background-color: white; -fx-background-insets: 0; -fx-background-radius: 8px; -fx-border-color: #D8E3EB; -fx-border-radius: 8px; -fx-padding: 12px; -fx-font-size: 14px; -fx-text-fill: #142D45;" />
                                </VBox>

                                <VBox spacing="7">
                                    <Label text="Email address *"
                                           style="-fx-font-size: 12px; -fx-font-weight: bold; -fx-text-fill: #142D45;" />

                                    <TextField fx:id="emailField"
                                               style="-fx-background-color: white; -fx-background-insets: 0; -fx-background-radius: 8px; -fx-border-color: #D8E3EB; -fx-border-radius: 8px; -fx-padding: 12px; -fx-font-size: 14px; -fx-text-fill: #142D45;" />
                                </VBox>

                                <VBox spacing="7">
                                    <Label text="Safe phone *"
                                           style="-fx-font-size: 12px; -fx-font-weight: bold; -fx-text-fill: #142D45;" />

                                    <TextField fx:id="phoneField"
                                               style="-fx-background-color: white; -fx-background-insets: 0; -fx-background-radius: 8px; -fx-border-color: #D8E3EB; -fx-border-radius: 8px; -fx-padding: 12px; -fx-font-size: 14px; -fx-text-fill: #142D45;" />
                                </VBox>

                                <VBox spacing="7">
                                    <Label text="Primary location"
                                           style="-fx-font-size: 12px; -fx-font-weight: bold; -fx-text-fill: #142D45;" />

                                    <TextField fx:id="addressField"
                                               style="-fx-background-color: white; -fx-background-insets: 0; -fx-background-radius: 8px; -fx-border-color: #D8E3EB; -fx-border-radius: 8px; -fx-padding: 12px; -fx-font-size: 14px; -fx-text-fill: #142D45;" />
                                </VBox>

                                <Button text="Save profile"
                                        onAction="#saveProfile"
                                        maxWidth="Infinity"
                                        style="-fx-background-color: #008681; -fx-background-insets: 0; -fx-background-radius: 8px; -fx-text-fill: white; -fx-font-weight: bold; -fx-font-size: 14px; -fx-padding: 14px; -fx-min-height: 50px; -fx-cursor: hand;" />

                                <Button text="Cancel"
                                        onAction="#closeProfile"
                                        maxWidth="Infinity"
                                        style="-fx-background-color: white; -fx-background-insets: 0; -fx-background-radius: 8px; -fx-border-color: #D8E3EB; -fx-border-radius: 8px; -fx-text-fill: #008681; -fx-font-weight: bold; -fx-font-size: 14px; -fx-padding: 13px; -fx-min-height: 48px; -fx-cursor: hand;" />
                            </VBox>

                            <Button text="Manage your household"
                                    onAction="#manageHousehold"
                                    maxWidth="Infinity"
                                    style="-fx-background-color: white; -fx-background-insets: 0; -fx-background-radius: 8px; -fx-border-color: #D8E3EB; -fx-border-radius: 8px; -fx-text-fill: #008681; -fx-font-weight: bold; -fx-font-size: 14px; -fx-padding: 13px; -fx-min-height: 48px; -fx-cursor: hand;" />

                            <!-- Household manager -->
                            <VBox fx:id="householdPanel"
                                  spacing="14"
                                  minHeight="-Infinity"
                                  visible="false"
                                  managed="false"
                                  style="-fx-background-color: white; -fx-background-radius: 12px; -fx-border-color: #D8E3EB; -fx-border-radius: 12px; -fx-padding: 16px;">

                                <VBox fx:id="householdList"
                                      spacing="10"
                                      minHeight="-Infinity" />

                                <VBox spacing="7">
                                    <Label text="New household name"
                                           style="-fx-font-size: 12px; -fx-font-weight: bold; -fx-text-fill: #142D45;" />

                                    <TextField fx:id="householdNameField"
                                               style="-fx-background-color: white; -fx-background-insets: 0; -fx-background-radius: 8px; -fx-border-color: #D8E3EB; -fx-border-radius: 8px; -fx-padding: 12px; -fx-font-size: 14px; -fx-text-fill: #142D45;" />
                                </VBox>

                                <Button text="Create household"
                                        onAction="#createHousehold"
                                        maxWidth="Infinity"
                                        style="-fx-background-color: white; -fx-background-insets: 0; -fx-background-radius: 8px; -fx-border-color: #D8E3EB; -fx-border-radius: 8px; -fx-text-fill: #008681; -fx-font-weight: bold; -fx-font-size: 14px; -fx-padding: 13px; -fx-min-height: 48px; -fx-cursor: hand;" />

                                <VBox spacing="7">
                                    <Label text="Household"
                                           style="-fx-font-size: 12px; -fx-font-weight: bold; -fx-text-fill: #142D45;" />

                                    <ComboBox fx:id="householdChoice"
                                              maxWidth="Infinity"
                                              style="-fx-background-color: white; -fx-background-insets: 0; -fx-background-radius: 8px; -fx-border-color: #D8E3EB; -fx-border-radius: 8px; -fx-padding: 12px; -fx-font-size: 14px; -fx-text-fill: #142D45;" />
                                </VBox>

                                <VBox spacing="7">
                                    <Label text="Member name"
                                           style="-fx-font-size: 12px; -fx-font-weight: bold; -fx-text-fill: #142D45;" />

                                    <TextField fx:id="memberNameField"
                                               style="-fx-background-color: white; -fx-background-insets: 0; -fx-background-radius: 8px; -fx-border-color: #D8E3EB; -fx-border-radius: 8px; -fx-padding: 12px; -fx-font-size: 14px; -fx-text-fill: #142D45;" />
                                </VBox>

                                <VBox spacing="7">
                                    <Label text="Age"
                                           style="-fx-font-size: 12px; -fx-font-weight: bold; -fx-text-fill: #142D45;" />

                                    <TextField fx:id="memberAgeField"
                                               text="0"
                                               style="-fx-background-color: white; -fx-background-insets: 0; -fx-background-radius: 8px; -fx-border-color: #D8E3EB; -fx-border-radius: 8px; -fx-padding: 12px; -fx-font-size: 14px; -fx-text-fill: #142D45;" />
                                </VBox>

                                <Button text="Add household member"
                                        onAction="#addMember"
                                        maxWidth="Infinity"
                                        style="-fx-background-color: #008681; -fx-background-insets: 0; -fx-background-radius: 8px; -fx-text-fill: white; -fx-font-weight: bold; -fx-font-size: 14px; -fx-padding: 14px; -fx-min-height: 50px; -fx-cursor: hand;" />
                            </VBox>

                            <!-- Primary location -->
                            <Label text="Primary location"
                                   style="-fx-font-size: 13px; -fx-font-weight: bold; -fx-text-fill: #142D45;" />

                            <Button fx:id="primaryLocationButton"
                                    text="Set your primary location"
                                    onAction="#editLocation"
                                    maxWidth="Infinity"
                                    style="-fx-background-color: white; -fx-background-insets: 0; -fx-background-radius: 8px; -fx-border-color: #D8E3EB; -fx-border-radius: 8px; -fx-text-fill: #008681; -fx-font-weight: bold; -fx-font-size: 14px; -fx-padding: 13px; -fx-min-height: 48px; -fx-cursor: hand;" />

                            <!-- Alerts -->
                            <Label text="Critical area alerts"
                                   style="-fx-font-size: 13px; -fx-font-weight: bold; -fx-text-fill: #142D45;" />

                            <Button text="Device notifications not enabled"
                                    onAction="#showAlerts"
                                    maxWidth="Infinity"
                                    style="-fx-background-color: white; -fx-background-insets: 0; -fx-background-radius: 8px; -fx-border-color: #D8E3EB; -fx-border-radius: 8px; -fx-text-fill: #008681; -fx-font-weight: bold; -fx-font-size: 14px; -fx-padding: 13px; -fx-min-height: 48px; -fx-cursor: hand;" />

                            <VBox fx:id="alertsPanel"
                                  spacing="8"
                                  minHeight="-Infinity"
                                  visible="false"
                                  managed="false"
                                  style="-fx-background-color: white; -fx-background-radius: 12px; -fx-border-color: #D8E3EB; -fx-border-radius: 12px; -fx-padding: 16px;">

                                <Label text="This desktop app does not deliver background weather alerts. Check storm information in Home."
                                       wrapText="true"
                                       minHeight="-Infinity"
                                       maxWidth="Infinity"
                                       style="-fx-font-size: 13px; -fx-text-fill: #587083;" />

                                <Button text="Open Home"
                                        onAction="#openHome"
                                        maxWidth="Infinity"
                                        style="-fx-background-color: white; -fx-background-insets: 0; -fx-background-radius: 8px; -fx-border-color: #D8E3EB; -fx-border-radius: 8px; -fx-text-fill: #008681; -fx-font-weight: bold; -fx-font-size: 14px; -fx-padding: 13px; -fx-min-height: 48px; -fx-cursor: hand;" />
                            </VBox>

                            <!-- Request updates -->
                            <Label text="Request updates"
                                   style="-fx-font-size: 13px; -fx-font-weight: bold; -fx-text-fill: #142D45;" />

                            <Button text="View updates in My requests"
                                    onAction="#openRequests"
                                    maxWidth="Infinity"
                                    style="-fx-background-color: white; -fx-background-insets: 0; -fx-background-radius: 8px; -fx-border-color: #D8E3EB; -fx-border-radius: 8px; -fx-text-fill: #008681; -fx-font-weight: bold; -fx-font-size: 14px; -fx-padding: 13px; -fx-min-height: 48px; -fx-cursor: hand;" />

                            <!-- Language -->
                            <Label text="Language"
                                   style="-fx-font-size: 13px; -fx-font-weight: bold; -fx-text-fill: #142D45;" />

                            <Label text="English"
                                   style="-fx-font-size: 13px; -fx-text-fill: #587083;" />

                            <!-- Accessibility -->
                            <Label text="Accessibility"
                                   style="-fx-font-size: 13px; -fx-font-weight: bold; -fx-text-fill: #142D45;" />

                            <Button text="Text size and motion preferences"
                                    onAction="#showAccessibility"
                                    maxWidth="Infinity"
                                    style="-fx-background-color: white; -fx-background-insets: 0; -fx-background-radius: 8px; -fx-border-color: #D8E3EB; -fx-border-radius: 8px; -fx-text-fill: #008681; -fx-font-weight: bold; -fx-font-size: 14px; -fx-padding: 13px; -fx-min-height: 48px; -fx-cursor: hand;" />

                            <VBox fx:id="accessibilityPanel"
                                  spacing="12"
                                  minHeight="-Infinity"
                                  visible="false"
                                  managed="false"
                                  style="-fx-background-color: white; -fx-background-radius: 12px; -fx-border-color: #D8E3EB; -fx-border-radius: 12px; -fx-padding: 16px;">

                                <VBox spacing="7">
                                    <Label text="Text size"
                                           style="-fx-font-size: 12px; -fx-font-weight: bold; -fx-text-fill: #142D45;" />

                                    <ComboBox fx:id="textSizeChoice"
                                              maxWidth="Infinity"
                                              style="-fx-background-color: white; -fx-background-insets: 0; -fx-background-radius: 8px; -fx-border-color: #D8E3EB; -fx-border-radius: 8px; -fx-padding: 12px; -fx-font-size: 14px; -fx-text-fill: #142D45;" />
                                </VBox>

                                <CheckBox fx:id="reducedMotion"
                                          text="Reduce motion"
                                          wrapText="true" />

                                <Label text="These screens use no animations. Text size applies when opening app screens."
                                       wrapText="true"
                                       minHeight="-Infinity"
                                       maxWidth="Infinity"
                                       style="-fx-font-size: 12px; -fx-text-fill: #587083;" />

                                <Button text="Save preferences"
                                        onAction="#saveAccessibility"
                                        maxWidth="Infinity"
                                        style="-fx-background-color: #008681; -fx-background-insets: 0; -fx-background-radius: 8px; -fx-text-fill: white; -fx-font-weight: bold; -fx-font-size: 14px; -fx-padding: 14px; -fx-min-height: 50px; -fx-cursor: hand;" />
                            </VBox>

                            <!-- Privacy -->
                            <VBox spacing="7"
                                  minHeight="-Infinity"
                                  style="-fx-background-color: #E4F3F0; -fx-background-radius: 9px; -fx-padding: 14px;">

                                <Label text="Permissions &amp; privacy"
                                       wrapText="true"
                                       minHeight="-Infinity"
                                       style="-fx-font-size: 13px; -fx-font-weight: bold; -fx-text-fill: #008681;" />

                                <Label text="Your primary location can be entered manually. Local preferences and offline notes stay on this device."
                                       wrapText="true"
                                       minHeight="-Infinity"
                                       maxWidth="Infinity"
                                       style="-fx-font-size: 12px; -fx-text-fill: #142D45;" />
                            </VBox>

                            <!-- Offline notes -->
                            <Button text="Manage offline safety notes"
                                    onAction="#showOffline"
                                    maxWidth="Infinity"
                                    style="-fx-background-color: white; -fx-background-insets: 0; -fx-background-radius: 8px; -fx-border-color: #D8E3EB; -fx-border-radius: 8px; -fx-text-fill: #008681; -fx-font-weight: bold; -fx-font-size: 14px; -fx-padding: 13px; -fx-min-height: 48px; -fx-cursor: hand;" />

                            <VBox fx:id="offlinePanel"
                                  spacing="12"
                                  minHeight="-Infinity"
                                  visible="false"
                                  managed="false"
                                  style="-fx-background-color: white; -fx-background-radius: 12px; -fx-border-color: #D8E3EB; -fx-border-radius: 12px; -fx-padding: 16px;">

                                <VBox spacing="7">
                                    <Label text="Your offline safety notes"
                                           style="-fx-font-size: 12px; -fx-font-weight: bold; -fx-text-fill: #142D45;" />

                                    <TextArea fx:id="offlineNotes"
                                              wrapText="true"
                                              prefRowCount="3"
                                              promptText="Add the safety notes you want to keep on this device."
                                              style="-fx-background-color: white; -fx-background-insets: 0; -fx-background-radius: 8px; -fx-border-color: #D8E3EB; -fx-border-radius: 8px; -fx-padding: 12px; -fx-font-size: 14px; -fx-text-fill: #142D45;" />
                                </VBox>

                                <Label text="These are your saved notes, not live alerts or verified emergency instructions."
                                       wrapText="true"
                                       minHeight="-Infinity"
                                       maxWidth="Infinity"
                                       style="-fx-font-size: 12px; -fx-text-fill: #587083;" />

                                <Button text="Save offline notes"
                                        onAction="#saveOffline"
                                        maxWidth="Infinity"
                                        style="-fx-background-color: #008681; -fx-background-insets: 0; -fx-background-radius: 8px; -fx-text-fill: white; -fx-font-weight: bold; -fx-font-size: 14px; -fx-padding: 14px; -fx-min-height: 50px; -fx-cursor: hand;" />
                            </VBox>

                            <Button text="Sign out"
                                    onAction="#signOut"
                                    maxWidth="Infinity"
                                    style="-fx-background-color: white; -fx-background-insets: 0; -fx-background-radius: 8px; -fx-border-color: #D8E3EB; -fx-border-radius: 8px; -fx-text-fill: #008681; -fx-font-weight: bold; -fx-font-size: 14px; -fx-padding: 13px; -fx-min-height: 48px; -fx-cursor: hand;" />
                        </VBox>
                    </StackPane>
                </content>
            </ScrollPane>
        </center>

        <!-- Fixed bottom navigation -->
        <bottom>
            <HBox alignment="CENTER"
                  style="-fx-background-color: white; -fx-border-color: #D8E3EB transparent transparent transparent; -fx-padding: 10px;">

                <Button text="⌂&#10;Home"
                        onAction="#openHome"
                        HBox.hgrow="ALWAYS"
                        maxWidth="Infinity"
                        prefWidth="90"
                        minWidth="0"
                        style="-fx-background-color: transparent; -fx-font-size: 11px; -fx-min-height: 52px; -fx-text-fill: #587083;" />

                <Button text="▤&#10;Requests"
                        onAction="#openRequests"
                        HBox.hgrow="ALWAYS"
                        maxWidth="Infinity"
                        prefWidth="90"
                        minWidth="0"
                        style="-fx-background-color: transparent; -fx-font-size: 11px; -fx-min-height: 52px; -fx-text-fill: #587083;" />

                <Button text="◇&#10;Safety"
                        onAction="#openSafety"
                        HBox.hgrow="ALWAYS"
                        maxWidth="Infinity"
                        prefWidth="90"
                        minWidth="0"
                        style="-fx-background-color: transparent; -fx-font-size: 11px; -fx-min-height: 52px; -fx-text-fill: #587083;" />

                <Button text="♙&#10;Account"
                        onAction="#openAccount"
                        HBox.hgrow="ALWAYS"
                        maxWidth="Infinity"
                        prefWidth="90"
                        minWidth="0"
                        style="-fx-background-color: transparent; -fx-font-size: 11px; -fx-min-height: 52px; -fx-text-fill: #008681; -fx-font-weight: bold;" />
            </HBox>
        </bottom>
    </BorderPane>
</StackPane>