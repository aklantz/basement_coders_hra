<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.shape.SVGPath?>

<StackPane fx:id="requestsRoot"
           xmlns="http://javafx.com/javafx/13"
           xmlns:fx="http://javafx.com/fxml/1"
           fx:controller="com.controllers.MyRequestsController"
           focusTraversable="true"
           prefWidth="390.0"
           prefHeight="874.0"
           style="-fx-background-color: #F4F7FA;
                  -fx-font-family: 'Segoe UI';
                  -fx-font-size: 14px;
                  -fx-padding: 0;">

    <children>
        <BorderPane fx:id="mainContent">
            <center>
                <ScrollPane fitToWidth="true"
                            hbarPolicy="NEVER"
                            style="-fx-background: #F4F7FA;
                                   -fx-background-color: #F4F7FA;
                                   -fx-background-insets: 0;
                                   -fx-padding: 0;">
                    <content>
                        <StackPane alignment="TOP_CENTER">
                            <children>
                                <VBox spacing="20.0"
                                      maxWidth="390.0"
                                      minHeight="-Infinity">
                                    <padding>
                                        <Insets top="20.0"
                                                right="22.0"
                                                bottom="28.0"
                                                left="22.0" />
                                    </padding>

                                    <children>
                                        <HBox alignment="CENTER_LEFT"
                                              spacing="8.0">
                                            <children>
                                                <SVGPath
                                                    content="M 12 2 C 5 2 1 7 2 13 C 3 20 10 24 17 20 M 21 4 C 15 0 7 4 6 11 C 5 17 12 21 17 16 C 21 12 17 6 12 8"
                                                    fill="TRANSPARENT"
                                                    stroke="#087F7A"
                                                    strokeWidth="1.2" />

                                                <Label text="Hurricane Tracker"
                                                       style="-fx-font-size: 13px; -fx-text-fill: #142D45;" />
                                            </children>
                                        </HBox>

                                        <VBox spacing="7.0">
                                            <children>
                                                <Label text="My requests"
                                                       wrapText="true"
                                                       minHeight="-Infinity"
                                                       style="-fx-font-size: 27px; -fx-font-weight: bold; -fx-text-fill: #142D45;" />

                                                <Label text="Your household’s requests and latest updates."
                                                       wrapText="true"
                                                       minHeight="-Infinity"
                                                       style="-fx-font-size: 14px; -fx-text-fill: #536879;" />
                                            </children>
                                        </VBox>

                                        <HBox spacing="10.0"
                                              alignment="CENTER_LEFT">
                                            <children>
                                                <Label fx:id="activeCountLabel"
                                                       text="Active · 0"
                                                       style="-fx-background-color: #E4F3F0; -fx-background-radius: 12px; -fx-padding: 6px 10px; -fx-font-size: 11px; -fx-font-weight: bold; -fx-text-fill: #087F7A;" />

                                                <Label fx:id="previousCountLabel"
                                                       text="Previous · 0"
                                                       style="-fx-font-size: 11px; -fx-text-fill: #536879;" />
                                            </children>
                                        </HBox>

                                        <!-- Empty requests -->
                                        <VBox fx:id="emptyState"
                                              spacing="13.0"
                                              minHeight="-Infinity"
                                              style="-fx-background-color: white; -fx-background-radius: 12px; -fx-border-color: #DCE5EB; -fx-border-radius: 12px; -fx-padding: 20px;">
                                            <children>
                                                <SVGPath
                                                    content="M 5 3 L 2 3 L 2 21 L 18 21 L 18 3 L 15 3 M 5 1 L 15 1 L 15 5 L 5 5 Z M 6 10 L 14 10 M 6 14 L 14 14"
                                                    fill="TRANSPARENT"
                                                    stroke="#087F7A"
                                                    strokeWidth="1.3" />

                                                <Label text="No requests yet"
                                                       style="-fx-font-size: 17px; -fx-font-weight: bold; -fx-text-fill: #142D45;" />

                                                <Label text="You have no active or previous requests. If your household needs non-emergency supplies, you can create your first relief request."
                                                       wrapText="true"
                                                       minHeight="-Infinity"
                                                       style="-fx-font-size: 13px; -fx-text-fill: #536879;" />
                                            </children>
                                        </VBox>

                                        <!-- Existing requests -->
                                        <VBox fx:id="populatedState"
                                              spacing="20.0"
                                              visible="false"
                                              managed="false"
                                              minHeight="-Infinity">
                                            <children>
                                                <Label fx:id="noActiveLabel"
                                                       text="You have no active requests. Your previous requests are below."
                                                       wrapText="true"
                                                       minHeight="-Infinity"
                                                       style="-fx-font-size: 13px; -fx-text-fill: #536879;" />

                                                <VBox fx:id="activeRequests"
                                                      spacing="18.0"
                                                      minHeight="-Infinity" />

                                                <Label fx:id="previousHeading"
                                                       text="Previous requests"
                                                       style="-fx-font-size: 18px; -fx-font-weight: bold; -fx-text-fill: #142D45;" />

                                                <VBox fx:id="previousRequests"
                                                      spacing="18.0"
                                                      minHeight="-Infinity" />
                                            </children>
                                        </VBox>

                                        <Button fx:id="createRequestButton"
                                                text="Create relief request"
                                                onAction="#openCreateRequest"
                                                minWidth="0.0"
                                                maxWidth="Infinity"
                                                style="-fx-background-color: #087F7A; -fx-background-insets: 0; -fx-background-radius: 8px; -fx-text-fill: white; -fx-font-size: 14px; -fx-font-weight: bold; -fx-min-height: 52px; -fx-padding: 12px 16px; -fx-cursor: hand;" />

                                        <HBox spacing="12.0"
                                              alignment="TOP_LEFT"
                                              minHeight="-Infinity"
                                              style="-fx-background-color: #E4F3F0; -fx-background-radius: 9px; -fx-padding: 16px;">
                                            <children>
                                                <Label text="ⓘ"
                                                       style="-fx-font-size: 18px; -fx-text-fill: #087F7A;" />

                                                <VBox spacing="6.0"
                                                      minWidth="0.0"
                                                      prefWidth="0.0"
                                                      HBox.hgrow="ALWAYS">
                                                    <children>
                                                        <Label fx:id="supportHeading"
                                                               text="Before you request support"
                                                               wrapText="true"
                                                               minHeight="-Infinity"
                                                               style="-fx-font-size: 13px; -fx-font-weight: bold; -fx-text-fill: #087F7A;" />

                                                        <Label fx:id="supportMessage"
                                                               text="Relief requests are for non-emergency needs. Assistance and timing are not guaranteed."
                                                               wrapText="true"
                                                               minHeight="-Infinity"
                                                               style="-fx-font-size: 12px; -fx-text-fill: #142D45;" />
                                                    </children>
                                                </VBox>
                                            </children>
                                        </HBox>
                                    </children>
                                </VBox>
                            </children>
                        </StackPane>
                    </content>
                </ScrollPane>
            </center>

            <!-- Bottom navigation -->
            <bottom>
                <StackPane style="-fx-background-color: white; -fx-border-color: #DCE5EB transparent transparent transparent;">
                    <children>
                        <HBox alignment="CENTER"
                              maxWidth="390.0">
                            <padding>
                                <Insets top="8.0"
                                        right="10.0"
                                        bottom="10.0"
                                        left="10.0" />
                            </padding>

                            <children>
                                <Button text="Home"
                                        onAction="#openHome"
                                        contentDisplay="TOP"
                                        graphicTextGap="6.0"
                                        HBox.hgrow="ALWAYS"
                                        minWidth="0.0"
                                        prefWidth="90.0"
                                        maxWidth="Infinity"
                                        style="-fx-background-color: transparent; -fx-font-size: 10px; -fx-text-fill: #536879; -fx-min-height: 54px; -fx-cursor: hand;">
                                    <graphic>
                                        <SVGPath
                                            content="M 1 10 L 11 1 L 21 10 M 4 8 L 4 21 L 9 21 L 9 14 L 13 14 L 13 21 L 18 21 L 18 8"
                                            fill="TRANSPARENT"
                                            stroke="#536879"
                                            strokeWidth="1.3"
                                            mouseTransparent="true" />
                                    </graphic>
                                </Button>

                                <Button text="Requests"
                                        onAction="#refreshRequests"
                                        contentDisplay="TOP"
                                        graphicTextGap="6.0"
                                        HBox.hgrow="ALWAYS"
                                        minWidth="0.0"
                                        prefWidth="90.0"
                                        maxWidth="Infinity"
                                        style="-fx-background-color: transparent; -fx-font-size: 10px; -fx-text-fill: #087F7A; -fx-font-weight: bold; -fx-min-height: 54px; -fx-cursor: hand;">
                                    <graphic>
                                        <SVGPath
                                            content="M 5 3 L 2 3 L 2 21 L 18 21 L 18 3 L 15 3 M 5 1 L 15 1 L 15 5 L 5 5 Z M 6 10 L 14 10 M 6 14 L 14 14"
                                            fill="TRANSPARENT"
                                            stroke="#087F7A"
                                            strokeWidth="1.3"
                                            mouseTransparent="true" />
                                    </graphic>
                                </Button>

                                <Button text="Safety"
                                        onAction="#openSafety"
                                        contentDisplay="TOP"
                                        graphicTextGap="6.0"
                                        HBox.hgrow="ALWAYS"
                                        minWidth="0.0"
                                        prefWidth="90.0"
                                        maxWidth="Infinity"
                                        style="-fx-background-color: transparent; -fx-font-size: 10px; -fx-text-fill: #536879; -fx-min-height: 54px; -fx-cursor: hand;">
                                    <graphic>
                                        <SVGPath
                                            content="M 11 1 L 20 5 L 18 15 L 11 22 L 4 15 L 2 5 Z M 7 11 L 10 14 L 15 8"
                                            fill="TRANSPARENT"
                                            stroke="#536879"
                                            strokeWidth="1.3"
                                            mouseTransparent="true" />
                                    </graphic>
                                </Button>

                                <Button text="Account"
                                        onAction="#openAccount"
                                        contentDisplay="TOP"
                                        graphicTextGap="6.0"
                                        HBox.hgrow="ALWAYS"
                                        minWidth="0.0"
                                        prefWidth="90.0"
                                        maxWidth="Infinity"
                                        style="-fx-background-color: transparent; -fx-font-size: 10px; -fx-text-fill: #536879; -fx-min-height: 54px; -fx-cursor: hand;">
                                    <graphic>
                                        <SVGPath
                                            content="M 15 6 A 5 5 0 1 1 5 6 A 5 5 0 1 1 15 6 Z M 1 22 C 1 11 19 11 19 22"
                                            fill="TRANSPARENT"
                                            stroke="#536879"
                                            strokeWidth="1.3"
                                            mouseTransparent="true" />
                                    </graphic>
                                </Button>
                            </children>
                        </HBox>
                    </children>
                </StackPane>
            </bottom>
        </BorderPane>

        <!-- Request details popup -->
        <StackPane fx:id="overlay"
                   visible="false"
                   managed="false"
                   onKeyPressed="#handleOverlayKey"
                   style="-fx-background-color: rgba(20,45,69,0.30);">
            <padding>
                <Insets top="20.0"
                        right="20.0"
                        bottom="20.0"
                        left="20.0" />
            </padding>

            <children>
                <ScrollPane fx:id="overlayScroll"
                            fitToWidth="true"
                            hbarPolicy="NEVER"
                            maxWidth="346.0"
                            prefHeight="640.0"
                            maxHeight="${requestsRoot.height - 40}"
                            style="-fx-background: white;
                                   -fx-background-color: white;
                                   -fx-background-radius: 14px;
                                   -fx-padding: 0;">
                    <content>
                        <VBox spacing="18.0"
                              minHeight="-Infinity"
                              style="-fx-background-color: white;
                                     -fx-padding: 22px;">
                            <children>
                                <Label fx:id="overlayTitle"
                                       text="Your relief request"
                                       wrapText="true"
                                       minHeight="-Infinity"
                                       style="-fx-font-size: 23px;
                                              -fx-font-weight: bold;
                                              -fx-text-fill: #142D45;" />

                                <VBox fx:id="detailFields"
                                      spacing="12.0"
                                      minHeight="-Infinity" />

                                <Button fx:id="closeOverlayButton"
                                        text="Done"
                                        onAction="#closeOverlay"
                                        maxWidth="Infinity"
                                        style="-fx-background-color: white; -fx-background-insets: 0; -fx-background-radius: 8px; -fx-border-color: #DCE5EB; -fx-border-radius: 8px; -fx-text-fill: #087F7A; -fx-font-size: 14px; -fx-font-weight: bold; -fx-min-height: 52px; -fx-padding: 12px 16px; -fx-cursor: hand;" />
                            </children>
                        </VBox>
                    </content>
                </ScrollPane>
            </children>
        </StackPane>
    </children>
</StackPane>