<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.shape.SVGPath?>

<BorderPane xmlns="http://javafx.com/javafx/21"
            xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="com.controllers.UserHomeController"
            prefWidth="390.0"
            prefHeight="1140.0"
            style="-fx-background-color: #F4F7F9;
                   -fx-font-family: 'Segoe UI';
                   -fx-font-size: 14px;
                   -fx-padding: 0;">

    <center>
        <ScrollPane fitToWidth="true"
                    hbarPolicy="NEVER"
                    style="-fx-background: #F4F7F9;
                           -fx-background-color: #F4F7F9;
                           -fx-background-insets: 0;
                           -fx-padding: 0;">

            <content>
                <StackPane alignment="TOP_CENTER"
                           style="-fx-background-color: #F4F7F9;">

                    <children>
                        <VBox maxWidth="390.0"
                              minHeight="-Infinity"
                              spacing="18.0">

                            <padding>
                                <Insets top="18.0"
                                        right="22.0"
                                        bottom="20.0"
                                        left="22.0" />
                            </padding>

                            <children>
                                <!-- Header -->
                                <HBox alignment="CENTER_LEFT" spacing="8.0">
                                    <children>
                                        <SVGPath
                                            content="M 12 2 C 5 2 1 7 2 13 C 3 20 10 24 17 20 M 21 4 C 15 0 7 4 6 11 C 5 17 12 21 17 16 C 21 12 17 6 12 8 C 8 10 10 15 14 14"
                                            fill="TRANSPARENT"
                                            stroke="#087F7A"
                                            strokeWidth="1.2"
                                            mouseTransparent="true" />

                                        <Label text="Hurricane Tracker"
                                               style="-fx-font-size: 13px;
                                                      -fx-text-fill: #142D45;" />

                                        <Region HBox.hgrow="ALWAYS" />

                                        <Label fx:id="locationLabel"
                                               text="Tampa, FL"
                                               style="-fx-font-size: 11px;
                                                      -fx-text-fill: #536879;" />
                                    </children>
                                </HBox>

                                <!-- Welcome -->
                                <VBox spacing="6.0">
                                    <children>
                                        <Label fx:id="lbl_welcome"
                                               text="Welcome"
                                               wrapText="true"
                                               minHeight="-Infinity"
                                               style="-fx-font-size: 27px;
                                                      -fx-font-weight: bold;
                                                      -fx-text-fill: #142D45;" />

                                        <Label
                                            text="Your household’s storm and relief overview."
                                            wrapText="true"
                                            minHeight="-Infinity"
                                            style="-fx-font-size: 14px;
                                                   -fx-text-fill: #536879;" />
                                    </children>
                                </VBox>

                                <!-- Warning -->
                                <HBox spacing="12.0"
                                      alignment="TOP_LEFT"
                                      minHeight="-Infinity"
                                      style="-fx-background-color: #FFF3D9;
                                             -fx-background-radius: 9px;
                                             -fx-padding: 15px;">

                                    <children>
                                        <SVGPath
                                            content="M 10 1 L 20 19 L 0 19 Z M 10 6 L 10 12 M 10 15 L 10 16"
                                            fill="TRANSPARENT"
                                            stroke="#AD710F"
                                            strokeWidth="1.3"
                                            mouseTransparent="true" />

                                        <VBox spacing="5.0"
                                              minWidth="0.0"
                                              prefWidth="0.0"
                                              HBox.hgrow="ALWAYS">

                                            <children>
                                                <Label
                                                    text="Hurricane warning · Tampa"
                                                    wrapText="true"
                                                    minHeight="-Infinity"
                                                    style="-fx-font-size: 13px;
                                                           -fx-font-weight: bold;
                                                           -fx-text-fill: #94600D;" />

                                                <Label
                                                    text="Hurricane conditions are expected in the warning area. Follow local evacuation orders, not the map alone."
                                                    wrapText="true"
                                                    minHeight="-Infinity"
                                                    style="-fx-font-size: 12px;
                                                           -fx-text-fill: #142D45;
                                                           -fx-line-spacing: 2px;" />
                                            </children>
                                        </VBox>
                                    </children>
                                </HBox>

                                <!-- Storm and map -->
                                <VBox spacing="12.0">
                                    <children>
                                        <HBox alignment="CENTER_LEFT" spacing="8.0">
                                            <children>
                                                <Label text="Hurricane Maya"
                                                       style="-fx-font-size: 19px;
                                                              -fx-font-weight: bold;
                                                              -fx-text-fill: #142D45;" />

                                                <Region HBox.hgrow="ALWAYS" />

                                                <Label text="CATEGORY 2"
                                                       style="-fx-font-size: 10px;
                                                              -fx-font-weight: bold;
                                                              -fx-text-fill: #94600D;
                                                              -fx-background-color: #FFF0CE;
                                                              -fx-background-radius: 12px;
                                                              -fx-padding: 4px 9px;" />
                                            </children>
                                        </HBox>

                                        <StackPane
                                            fx:id="mapContainer"
                                            minHeight="232.0"
                                            prefHeight="232.0"
                                            maxHeight="232.0"
                                            maxWidth="Infinity"
                                            style="-fx-background-color: #E7EEF2;
                                                   -fx-background-radius: 10px;
                                                   -fx-border-color: #DCE5EB;
                                                   -fx-border-radius: 10px;">

                                            <children>
                                                <Label text="Map unavailable"
                                                       style="-fx-font-size: 13px;
                                                              -fx-text-fill: #536879;" />
                                            </children>
                                        </StackPane>

                                        <HBox alignment="CENTER_LEFT">
                                            <children>
                                                <Label text="100 mph winds"
                                                       style="-fx-font-size: 13px;
                                                              -fx-font-weight: bold;
                                                              -fx-text-fill: #142D45;" />

                                                <Region HBox.hgrow="ALWAYS" />

                                                <Label text="NNE at 12 mph"
                                                       style="-fx-font-size: 12px;
                                                              -fx-text-fill: #536879;" />
                                            </children>
                                        </HBox>

                                        <Label
                                            text="OCT 14, 2026 · 10:00 AM EDT"
                                            wrapText="true"
                                            minHeight="-Infinity"
                                            style="-fx-font-size: 10px;
                                                   -fx-font-weight: bold;
                                                   -fx-text-fill: #087F7A;" />
                                    </children>
                                </VBox>

                                <!-- Relief actions -->
                                <Label text="What do you need today?"
                                       wrapText="true"
                                       minHeight="-Infinity"
                                       style="-fx-font-size: 19px;
                                              -fx-font-weight: bold;
                                              -fx-text-fill: #142D45;" />

                                <Button
                                    fx:id="requestReliefButton"
                                    text="Request relief"
                                    onAction="#openRequestRelief"
                                    minWidth="0.0"
                                    maxWidth="Infinity"
                                    graphicTextGap="10.0"
                                    style="-fx-background-color: #087F7A;
                                           -fx-background-insets: 0;
                                           -fx-background-radius: 8px;
                                           -fx-text-fill: white;
                                           -fx-font-size: 14px;
                                           -fx-font-weight: bold;
                                           -fx-min-height: 52px;
                                           -fx-pref-height: 52px;
                                           -fx-cursor: hand;">

                                    <graphic>
                                        <SVGPath
                                            content="M 3 11 L 7 7 L 10 9 L 14 5 L 18 9 L 12 15 L 8 15 L 5 18 L 1 14 Z M 10 9 L 13 12"
                                            fill="TRANSPARENT"
                                            stroke="WHITE"
                                            strokeWidth="1.3"
                                            mouseTransparent="true" />
                                    </graphic>
                                </Button>

                                <Button
                                    fx:id="viewRequestsButton"
                                    text="View my requests · 1 active"
                                    onAction="#openRequests"
                                    minWidth="0.0"
                                    maxWidth="Infinity"
                                    graphicTextGap="10.0"
                                    style="-fx-background-color: white;
                                           -fx-background-insets: 0;
                                           -fx-background-radius: 8px;
                                           -fx-border-color: #DCE5EB;
                                           -fx-border-radius: 8px;
                                           -fx-text-fill: #087F7A;
                                           -fx-font-size: 13px;
                                           -fx-font-weight: bold;
                                           -fx-min-height: 52px;
                                           -fx-pref-height: 52px;
                                           -fx-cursor: hand;">

                                    <graphic>
                                        <SVGPath
                                            content="M 5 3 L 2 3 L 2 19 L 16 19 L 16 3 L 13 3 M 5 1 L 13 1 L 13 5 L 5 5 Z M 5 9 L 13 9 M 5 13 L 13 13"
                                            fill="TRANSPARENT"
                                            stroke="#087F7A"
                                            strokeWidth="1.2"
                                            mouseTransparent="true" />
                                    </graphic>
                                </Button>

                                <!-- Shelter row: constrained to 72px -->
                                <Button
                                    fx:id="findShelterButton"
                                    onAction="#openShelters"
                                    minWidth="0.0"
                                    prefWidth="346.0"
                                    maxWidth="Infinity"
                                    style="-fx-background-color: transparent;
                                           -fx-padding: 8px 0;
                                           -fx-min-height: 72px;
                                           -fx-pref-height: 72px;
                                           -fx-max-height: 72px;
                                           -fx-border-color: transparent transparent #DCE5EB transparent;
                                           -fx-alignment: center-left;
                                           -fx-cursor: hand;">

                                    <graphic>
                                        <HBox fx:id="shelterRow"
                                              alignment="CENTER_LEFT"
                                              spacing="12.0"
                                              prefWidth="290.0"
                                              minHeight="44.0"
                                              prefHeight="44.0"
                                              maxHeight="44.0"
                                              mouseTransparent="true">

                                            <children>
                                                <VBox spacing="5.0"
                                                      alignment="CENTER_LEFT"
                                                      minWidth="0.0"
                                                      HBox.hgrow="ALWAYS">

                                                    <children>
                                                        <Label
                                                            text="Find a nearby shelter"
                                                            style="-fx-font-size: 14px;
                                                                   -fx-font-weight: bold;
                                                                   -fx-text-fill: #142D45;" />

                                                        <Label
                                                            text="Accessibility, pets and contact details"
                                                            style="-fx-font-size: 11px;
                                                                   -fx-text-fill: #536879;" />
                                                    </children>
                                                </VBox>

                                                <Label text="›"
                                                       style="-fx-font-size: 24px;
                                                              -fx-text-fill: #087F7A;" />
                                            </children>
                                        </HBox>
                                    </graphic>
                                </Button>

                                <!-- Safety row: constrained to 72px -->
                                <Button
                                    fx:id="safetyChecklistButton"
                                    onAction="#openSafety"
                                    minWidth="0.0"
                                    prefWidth="346.0"
                                    maxWidth="Infinity"
                                    style="-fx-background-color: transparent;
                                           -fx-padding: 8px 0;
                                           -fx-min-height: 72px;
                                           -fx-pref-height: 72px;
                                           -fx-max-height: 72px;
                                           -fx-border-color: transparent transparent #DCE5EB transparent;
                                           -fx-alignment: center-left;
                                           -fx-cursor: hand;">

                                    <graphic>
                                        <HBox fx:id="safetyRow"
                                              alignment="CENTER_LEFT"
                                              spacing="12.0"
                                              prefWidth="290.0"
                                              minHeight="44.0"
                                              prefHeight="44.0"
                                              maxHeight="44.0"
                                              mouseTransparent="true">

                                            <children>
                                                <VBox spacing="5.0"
                                                      alignment="CENTER_LEFT"
                                                      minWidth="0.0"
                                                      HBox.hgrow="ALWAYS">

                                                    <children>
                                                        <Label
                                                            text="Your hurricane safety checklist"
                                                            style="-fx-font-size: 14px;
                                                                   -fx-font-weight: bold;
                                                                   -fx-text-fill: #142D45;" />

                                                        <Label
                                                            text="Saved for offline use"
                                                            style="-fx-font-size: 11px;
                                                                   -fx-text-fill: #536879;" />
                                                    </children>
                                                </VBox>

                                                <Label text="›"
                                                       style="-fx-font-size: 24px;
                                                              -fx-text-fill: #087F7A;" />
                                            </children>
                                        </HBox>
                                    </graphic>
                                </Button>

                                <Label
                                    text="Immediate danger? Call 911 in the US. Relief requests are not monitored for emergencies."
                                    wrapText="true"
                                    minHeight="-Infinity"
                                    style="-fx-font-size: 11px;
                                           -fx-text-fill: #536879;" />
                            </children>
                        </VBox>
                    </children>
                </StackPane>
            </content>
        </ScrollPane>
    </center>

    <!-- Bottom navigation stays visible while scrolling -->
    <bottom>
        <StackPane
            style="-fx-background-color: white;
                   -fx-border-color: #DCE5EB transparent transparent transparent;">

            <children>
                <HBox alignment="CENTER" maxWidth="390.0">
                    <padding>
                        <Insets top="8.0"
                                right="10.0"
                                bottom="10.0"
                                left="10.0" />
                    </padding>

                    <children>
                        <Button
                            text="Home"
                            contentDisplay="TOP"
                            graphicTextGap="6.0"
                            HBox.hgrow="ALWAYS"
                            minWidth="0.0"
                            prefWidth="90.0"
                            maxWidth="Infinity"
                            style="-fx-background-color: transparent;
                                   -fx-text-fill: #087F7A;
                                   -fx-font-size: 10px;
                                   -fx-font-weight: bold;
                                   -fx-min-height: 54px;">

                            <graphic>
                                <SVGPath
                                    content="M 1 10 L 11 1 L 21 10 M 4 8 L 4 21 L 9 21 L 9 14 L 13 14 L 13 21 L 18 21 L 18 8"
                                    fill="TRANSPARENT"
                                    stroke="#087F7A"
                                    strokeWidth="1.4"
                                    mouseTransparent="true" />
                            </graphic>
                        </Button>

                        <Button
                            text="Requests"
                            onAction="#openRequests"
                            contentDisplay="TOP"
                            graphicTextGap="6.0"
                            HBox.hgrow="ALWAYS"
                            minWidth="0.0"
                            prefWidth="90.0"
                            maxWidth="Infinity"
                            style="-fx-background-color: transparent;
                                   -fx-text-fill: #536879;
                                   -fx-font-size: 10px;
                                   -fx-min-height: 54px;
                                   -fx-cursor: hand;">

                            <graphic>
                                <SVGPath
                                    content="M 5 3 L 2 3 L 2 21 L 18 21 L 18 3 L 15 3 M 5 1 L 15 1 L 15 5 L 5 5 Z M 6 10 L 14 10 M 6 14 L 14 14"
                                    fill="TRANSPARENT"
                                    stroke="#536879"
                                    strokeWidth="1.3"
                                    mouseTransparent="true" />
                            </graphic>
                        </Button>

                        <Button
                            text="Safety"
                            onAction="#openSafety"
                            contentDisplay="TOP"
                            graphicTextGap="6.0"
                            HBox.hgrow="ALWAYS"
                            minWidth="0.0"
                            prefWidth="90.0"
                            maxWidth="Infinity"
                            style="-fx-background-color: transparent;
                                   -fx-text-fill: #536879;
                                   -fx-font-size: 10px;
                                   -fx-min-height: 54px;
                                   -fx-cursor: hand;">

                            <graphic>
                                <SVGPath
                                    content="M 11 1 L 20 5 L 18 15 L 11 22 L 4 15 L 2 5 Z M 7 11 L 10 14 L 15 8"
                                    fill="TRANSPARENT"
                                    stroke="#536879"
                                    strokeWidth="1.3"
                                    mouseTransparent="true" />
                            </graphic>
                        </Button>

                        <Button
                            text="Account"
                            onAction="#openAccount"
                            contentDisplay="TOP"
                            graphicTextGap="6.0"
                            HBox.hgrow="ALWAYS"
                            minWidth="0.0"
                            prefWidth="90.0"
                            maxWidth="Infinity"
                            style="-fx-background-color: transparent;
                                   -fx-text-fill: #536879;
                                   -fx-font-size: 10px;
                                   -fx-min-height: 54px;
                                   -fx-cursor: hand;">

                            <graphic>
                                <SVGPath
                                    content="M 15 6 A 5 5 0 1 1 5 6 A 5 5 0 1 1 15 6 Z M 1 22 C 1 11 19 11 19 22"
                                    fill="TRANSPARENT"
                                    stroke="#536879"
                                    strokeWidth="1.3"
                                    mouseTransparent="true" />
                            </graphic>
                        </Button>
                    </children>
                </HBox>
            </children>
        </StackPane>
    </bottom>
</BorderPane>