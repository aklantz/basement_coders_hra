<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.shape.SVGPath?>

<StackPane fx:id="checkEmailRoot"
           xmlns="http://javafx.com/javafx/21"
           xmlns:fx="http://javafx.com/fxml/1"
           fx:controller="com.controllers.CheckEmailController"
           focusTraversable="true"
           prefWidth="390.0"
           prefHeight="874.0"
           style="-fx-background-color: #F4F7FA;
                  -fx-font-family: 'Segoe UI';
                  -fx-padding: 0;">

    <children>
        <!-- Main screen -->
        <ScrollPane fx:id="checkEmailContent"
                    fitToWidth="true"
                    fitToHeight="true"
                    hbarPolicy="NEVER"
                    style="-fx-background: #F4F7FA;
                           -fx-background-color: #F4F7FA;
                           -fx-background-insets: 0;
                           -fx-padding: 0;">

            <content>
                <StackPane alignment="TOP_CENTER"
                           style="-fx-background-color: #F4F7FA;">

                    <children>
                        <VBox spacing="20.0"
                              maxWidth="390.0"
                              minHeight="-Infinity"
                              alignment="TOP_LEFT">

                            <padding>
                                <Insets top="30.0"
                                        right="22.0"
                                        bottom="30.0"
                                        left="22.0" />
                            </padding>

                            <children>
                                <!-- Back -->
                                <Button
                                    text="Back"
                                    onAction="#backToForgotPassword"
                                    style="-fx-background-color: transparent;
                                           -fx-text-fill: #536879;
                                           -fx-font-size: 13px;
                                           -fx-padding: 0;
                                           -fx-min-height: 40px;
                                           -fx-alignment: center-left;
                                           -fx-graphic-text-gap: 8px;
                                           -fx-cursor: hand;">

                                    <graphic>
                                        <SVGPath
                                            content="M 14 2 L 5 11 L 14 20 M 5 11 L 24 11"
                                            fill="TRANSPARENT"
                                            stroke="#087F7A"
                                            strokeWidth="1.5"
                                            mouseTransparent="true" />
                                    </graphic>
                                </Button>

                                <!-- Heading -->
                                <VBox spacing="8.0">
                                    <children>
                                        <Label
                                            text="Check your email"
                                            wrapText="true"
                                            minHeight="-Infinity"
                                            style="-fx-font-size: 28px;
                                                   -fx-font-weight: bold;
                                                   -fx-text-fill: #142D45;" />

                                        <Label
                                            text="If an account matches this email address, a password reset link will be sent."
                                            wrapText="true"
                                            minHeight="-Infinity"
                                            style="-fx-font-size: 14px;
                                                   -fx-text-fill: #536879;
                                                   -fx-line-spacing: 3px;" />
                                    </children>
                                </VBox>

                                <!-- Email information -->
                                <VBox spacing="12.0"
                                      minHeight="-Infinity"
                                      style="-fx-background-color: white;
                                             -fx-background-radius: 9px;
                                             -fx-border-color: #DCE5EB;
                                             -fx-border-radius: 9px;
                                             -fx-padding: 16px;">

                                    <children>
                                        <Label
                                            fx:id="emailAddressLabel"
                                            text="Your email address"
                                            wrapText="true"
                                            minWidth="0.0"
                                            minHeight="-Infinity"
                                            style="-fx-font-size: 14px;
                                                   -fx-font-weight: bold;
                                                   -fx-text-fill: #142D45;" />

                                        <Label
                                            text="Follow the link in the email to choose a new password. For your privacy, we don’t confirm whether an account exists."
                                            wrapText="true"
                                            minHeight="-Infinity"
                                            style="-fx-font-size: 13px;
                                                   -fx-text-fill: #536879;
                                                   -fx-line-spacing: 3px;" />
                                    </children>
                                </VBox>

                                <!-- Help information -->
                                <HBox spacing="12.0"
                                      alignment="TOP_LEFT"
                                      minHeight="-Infinity"
                                      style="-fx-background-color: #E4F3F0;
                                             -fx-background-radius: 9px;
                                             -fx-padding: 16px;">

                                    <children>
                                        <Label
                                            text="ⓘ"
                                            style="-fx-font-size: 18px;
                                                   -fx-text-fill: #087F7A;" />

                                        <VBox spacing="6.0"
                                              minWidth="0.0"
                                              prefWidth="0.0"
                                              minHeight="-Infinity"
                                              HBox.hgrow="ALWAYS">

                                            <children>
                                                <Label
                                                    text="Haven’t received an email?"
                                                    wrapText="true"
                                                    minHeight="-Infinity"
                                                    style="-fx-font-size: 13px;
                                                           -fx-font-weight: bold;
                                                           -fx-text-fill: #087F7A;" />

                                                <Label
                                                    text="Allow a few minutes and check your spam or junk folder. You can request another link below."
                                                    wrapText="true"
                                                    minHeight="-Infinity"
                                                    style="-fx-font-size: 12px;
                                                           -fx-text-fill: #142D45;
                                                           -fx-line-spacing: 2px;" />
                                            </children>
                                        </VBox>
                                    </children>
                                </HBox>

                                <!-- Actions -->
                                <VBox spacing="12.0">
                                    <children>
                                        <Button
                                            text="Return to log in"
                                            maxWidth="Infinity"
                                            onAction="#returnToLogin"
                                            style="-fx-background-color: #087F7A;
                                                   -fx-background-insets: 0;
                                                   -fx-background-radius: 9px;
                                                   -fx-text-fill: white;
                                                   -fx-font-size: 15px;
                                                   -fx-font-weight: bold;
                                                   -fx-min-height: 52px;
                                                   -fx-padding: 12px 18px;
                                                   -fx-cursor: hand;" />

                                        <Button
                                            fx:id="resendButton"
                                            text="Resend reset link"
                                            maxWidth="Infinity"
                                            onAction="#resendResetLink"
                                            style="-fx-background-color: white;
                                                   -fx-background-insets: 0;
                                                   -fx-background-radius: 9px;
                                                   -fx-border-color: #DCE5EB;
                                                   -fx-border-radius: 9px;
                                                   -fx-text-fill: #087F7A;
                                                   -fx-font-size: 15px;
                                                   -fx-font-weight: bold;
                                                   -fx-min-height: 52px;
                                                   -fx-padding: 12px 18px;
                                                   -fx-cursor: hand;" />
                                    </children>
                                </VBox>
                            </children>
                        </VBox>
                    </children>
                </StackPane>
            </content>
        </ScrollPane>

        <!-- Centered confirmation popup -->
        <StackPane fx:id="resendOverlay"
                   visible="false"
                   managed="false"
                   pickOnBounds="true"
                   onKeyPressed="#handleOverlayKey"
                   style="-fx-background-color: rgba(20, 45, 69, 0.30);">

            <padding>
                <Insets top="20.0"
                        right="20.0"
                        bottom="20.0"
                        left="20.0" />
            </padding>

            <children>
                <VBox alignment="CENTER"
                      spacing="18.0"
                      maxWidth="320.0"
                      maxHeight="-Infinity"
                      style="-fx-background-color: #F4F7FA;
                             -fx-background-radius: 16px;
                             -fx-border-color: #DCE5EB;
                             -fx-border-radius: 16px;
                             -fx-padding: 28px;
                             -fx-effect: dropshadow(gaussian,
                                 rgba(20, 45, 69, 0.20), 20, 0, 0, 6);">

                    <children>
                        <!-- Check mark -->
                        <StackPane minWidth="72.0"
                                   prefWidth="72.0"
                                   maxWidth="72.0"
                                   minHeight="72.0"
                                   prefHeight="72.0"
                                   maxHeight="72.0"
                                   style="-fx-background-color: #E4F3F0;
                                          -fx-background-radius: 36px;">

                            <children>
                                <SVGPath
                                    content="M 2 13 L 10 21 L 27 3"
                                    fill="TRANSPARENT"
                                    stroke="#087F7A"
                                    strokeWidth="4.0"
                                    strokeLineCap="ROUND"
                                    strokeLineJoin="ROUND" />
                            </children>
                        </StackPane>

                        <Label
                            text="Reset link re-sent"
                            wrapText="true"
                            minHeight="-Infinity"
                            textAlignment="CENTER"
                            style="-fx-font-size: 22px;
                                   -fx-font-weight: bold;
                                   -fx-text-fill: #142D45;" />

                        <Label
                            text="Check your inbox and spam or junk folder."
                            wrapText="true"
                            minHeight="-Infinity"
                            textAlignment="CENTER"
                            style="-fx-font-size: 14px;
                                   -fx-text-fill: #536879;" />

                        <Button
                            fx:id="resendDoneButton"
                            text="Done"
                            onAction="#closeResendPopup"
                            maxWidth="Infinity"
                            style="-fx-background-color: #087F7A;
                                   -fx-background-insets: 0;
                                   -fx-background-radius: 9px;
                                   -fx-text-fill: white;
                                   -fx-font-size: 15px;
                                   -fx-font-weight: bold;
                                   -fx-min-height: 52px;
                                   -fx-padding: 12px 18px;
                                   -fx-cursor: hand;" />
                    </children>
                </VBox>
            </children>
        </StackPane>
    </children>
</StackPane>