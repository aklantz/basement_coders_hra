<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.shape.SVGPath?>

<StackPane fx:id="forgotPasswordRoot"
           xmlns="http://javafx.com/javafx/21"
           xmlns:fx="http://javafx.com/fxml/1"
           fx:controller="com.controllers.ForgotPasswordController"
           focusTraversable="true"
           prefWidth="390.0"
           prefHeight="874.0"
           style="-fx-background-color: #F4F7FA;
                  -fx-font-family: 'Segoe UI';
                  -fx-padding: 0;">

    <children>
        <ScrollPane fitToWidth="true"
                    fitToHeight="true"
                    hbarPolicy="NEVER"
                    style="-fx-background: #F4F7FA;
                           -fx-background-color: #F4F7FA;
                           -fx-background-insets: 0;
                           -fx-padding: 0;">

            <content>
                <StackPane alignment="TOP_CENTER"
                           style="-fx-background-color: #F4F7FA;">

                    <children>
                        <VBox spacing="20.0"
                              maxWidth="390.0"
                              minHeight="-Infinity"
                              alignment="TOP_LEFT">

                            <padding>
                                <Insets top="30.0"
                                        right="22.0"
                                        bottom="30.0"
                                        left="22.0" />
                            </padding>

                            <children>
                                <Button text="Back"
                                        onAction="#returnToLogin"
                                        style="-fx-background-color: transparent;
                                               -fx-text-fill: #536879;
                                               -fx-font-size: 13px;
                                               -fx-padding: 0;
                                               -fx-min-height: 40px;
                                               -fx-alignment: center-left;
                                               -fx-graphic-text-gap: 8px;
                                               -fx-cursor: hand;">

                                    <graphic>
                                        <SVGPath
                                            content="M 14 2 L 5 11 L 14 20 M 5 11 L 24 11"
                                            fill="TRANSPARENT"
                                            stroke="#087F7A"
                                            strokeWidth="1.5"
                                            mouseTransparent="true" />
                                    </graphic>
                                </Button>

                                <VBox spacing="8.0">
                                    <children>
                                        <Label text="Forgot password?"
                                               wrapText="true"
                                               minHeight="-Infinity"
                                               style="-fx-font-size: 28px;
                                                      -fx-font-weight: bold;
                                                      -fx-text-fill: #142D45;" />

                                        <Label
                                            text="Enter the email address you use for Hurricane Tracker. We’ll help you reset your password."
                                            wrapText="true"
                                            minHeight="-Infinity"
                                            style="-fx-font-size: 14px;
                                                   -fx-text-fill: #536879;
                                                   -fx-line-spacing: 3px;" />
                                    </children>
                                </VBox>

                                <VBox spacing="8.0">
                                    <children>
                                        <Label text="Email address"
                                               style="-fx-font-size: 13px;
                                                      -fx-font-weight: bold;
                                                      -fx-text-fill: #142D45;" />

                                        <TextField
                                            fx:id="emailField"
                                            promptText="Enter your email address"
                                            accessibleText="Email address"
                                            onAction="#sendResetLink"
                                            style="-fx-background-color: white;
                                                   -fx-background-insets: 0;
                                                   -fx-background-radius: 9px;
                                                   -fx-border-color: #DCE5EB;
                                                   -fx-border-radius: 9px;
                                                   -fx-border-width: 1px;
                                                   -fx-padding: 13px 14px;
                                                   -fx-min-height: 52px;
                                                   -fx-pref-height: 52px;
                                                   -fx-font-size: 14px;
                                                   -fx-text-fill: #142D45;
                                                   -fx-prompt-text-fill: #728492;" />

                                        <Label
                                            fx:id="emailErrorLabel"
                                            text="Enter a valid email address."
                                            visible="false"
                                            managed="false"
                                            wrapText="true"
                                            minHeight="-Infinity"
                                            style="-fx-font-size: 12px;
                                                   -fx-text-fill: #B33535;" />

                                        <Label
                                            text="Use the email address associated with your account."
                                            wrapText="true"
                                            minHeight="-Infinity"
                                            style="-fx-font-size: 12px;
                                                   -fx-text-fill: #536879;" />
                                    </children>
                                </VBox>

                                <HBox alignment="TOP_LEFT"
                                      spacing="12.0"
                                      minHeight="-Infinity"
                                      style="-fx-background-color: #E4F3F0;
                                             -fx-background-radius: 9px;
                                             -fx-padding: 16px;">

                                    <children>
                                        <Label text="ⓘ"
                                               style="-fx-font-size: 18px;
                                                      -fx-text-fill: #087F7A;" />

                                        <VBox spacing="6.0"
                                              minWidth="0.0"
                                              prefWidth="0.0"
                                              minHeight="-Infinity"
                                              HBox.hgrow="ALWAYS">

                                            <children>
                                                <Label
                                                    text="Your requests stay saved"
                                                    wrapText="true"
                                                    minHeight="-Infinity"
                                                    style="-fx-font-size: 13px;
                                                           -fx-font-weight: bold;
                                                           -fx-text-fill: #087F7A;" />

                                                <Label
                                                    text="Resetting your password does not change your household details or relief requests."
                                                    wrapText="true"
                                                    minHeight="-Infinity"
                                                    style="-fx-font-size: 12px;
                                                           -fx-text-fill: #142D45;
                                                           -fx-line-spacing: 2px;" />
                                            </children>
                                        </VBox>
                                    </children>
                                </HBox>

                                <VBox spacing="12.0">
                                    <children>
                                        <Button
                                            text="Send reset link"
                                            defaultButton="true"
                                            maxWidth="Infinity"
                                            onAction="#sendResetLink"
                                            style="-fx-background-color: #087F7A;
                                                   -fx-background-insets: 0;
                                                   -fx-background-radius: 9px;
                                                   -fx-text-fill: white;
                                                   -fx-font-size: 15px;
                                                   -fx-font-weight: bold;
                                                   -fx-min-height: 52px;
                                                   -fx-padding: 12px 18px;
                                                   -fx-cursor: hand;" />

                                        <Button
                                            text="Return to log in"
                                            maxWidth="Infinity"
                                            onAction="#returnToLogin"
                                            style="-fx-background-color: white;
                                                   -fx-background-insets: 0;
                                                   -fx-background-radius: 9px;
                                                   -fx-border-color: #DCE5EB;
                                                   -fx-border-radius: 9px;
                                                   -fx-text-fill: #087F7A;
                                                   -fx-font-size: 15px;
                                                   -fx-font-weight: bold;
                                                   -fx-min-height: 52px;
                                                   -fx-padding: 12px 18px;
                                                   -fx-cursor: hand;" />
                                    </children>
                                </VBox>
                            </children>
                        </VBox>
                    </children>
                </StackPane>
            </content>
        </ScrollPane>
    </children>
</StackPane>