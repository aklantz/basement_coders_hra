<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.VBox?>

<ScrollPane fitToWidth="true"
            hbarPolicy="NEVER"
            stylesheets="@styles.css"
            xmlns="http://javafx.com/javafx/26"
            xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="com.controllers.VolunteerSkillsController">
    <content>
        <VBox styleClass="screen">
            <children>
                <HBox alignment="CENTER_LEFT">
                    <children>
                        <Button styleClass="back-button" onAction="#back" text="← Back" />
                        <Region HBox.hgrow="ALWAYS" />
                        <Label styleClass="hint" text="Volunteer" />
                    </children>
                </HBox>

                <Label styleClass="title" text="What can you help with?" />
                <Label styleClass="subtitle" text="Choose all skills and supplies you can offer." />

                <VBox fx:id="errorBox" styleClass="error-box" managed="false" visible="false">
                    <children>
                        <Label fx:id="lbl_error" styleClass="error-title" />
                    </children>
                </VBox>

                <VBox fx:id="skillList" spacing="10.0" />

                <Label styleClass="hint"
                       text="Medical and rescue tasks may require verified credentials. Only select skills you can safely provide." />

                <Button styleClass="primary-button" defaultButton="true"
                        onAction="#btnSubmitClicked" text="Submit for approval" />
            </children>
        </VBox>
    </content>
</ScrollPane>