<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.shape.SVGPath?>

<StackPane fx:id="safetyRoot"
           xmlns="http://javafx.com/javafx/21"
           xmlns:fx="http://javafx.com/fxml/1"
           fx:controller="com.controllers.SafetyController"
           focusTraversable="true"
           prefWidth="390.0"
           prefHeight="1100.0"
           style="-fx-background-color: #F4F7FA;
                  -fx-font-family: 'Segoe UI';
                  -fx-font-size: 14px;">

    <children>
        <BorderPane fx:id="mainContent">

            <center>
                <ScrollPane fitToWidth="true"
                            hbarPolicy="NEVER"
                            style="-fx-background: #F4F7FA;
                                   -fx-background-color: #F4F7FA;
                                   -fx-background-insets: 0;
                                   -fx-padding: 0;">

                    <content>
                        <StackPane alignment="TOP_CENTER">
                            <children>
                                <VBox spacing="18.0"
                                      maxWidth="390.0"
                                      minHeight="-Infinity">

                                    <padding>
                                        <Insets top="20.0"
                                                right="22.0"
                                                bottom="24.0"
                                                left="22.0" />
                                    </padding>

                                    <children>
                                        <!-- Header -->
                                        <HBox alignment="CENTER_LEFT"
                                              spacing="8.0">
                                            <children>
                                                <SVGPath
                                                    content="M 12 2 C 5 2 1 7 2 13 C 3 20 10 24 17 20 M 21 4 C 15 0 7 4 6 11 C 5 17 12 21 17 16 C 21 12 17 6 12 8"
                                                    fill="TRANSPARENT"
                                                    stroke="#087F7A"
                                                    strokeWidth="1.2" />

                                                <Label
                                                    text="Hurricane Tracker"
                                                    style="-fx-font-size: 13px;
                                                           -fx-text-fill: #142D45;" />

                                                <Region HBox.hgrow="ALWAYS" />

                                                <Label text="Tampa, FL"
                                                       style="-fx-font-size: 11px;
                                                              -fx-text-fill: #536879;" />
                                            </children>
                                        </HBox>

                                        <!-- Heading -->
                                        <VBox spacing="7.0">
                                            <children>
                                                <Label
                                                    text="Safety &amp; shelters"
                                                    wrapText="true"
                                                    minHeight="-Infinity"
                                                    style="-fx-font-size: 27px;
                                                           -fx-font-weight: bold;
                                                           -fx-text-fill: #142D45;" />

                                                <Label
                                                    text="Essential guidance and nearby shelter information in one place."
                                                    wrapText="true"
                                                    minHeight="-Infinity"
                                                    style="-fx-font-size: 14px;
                                                           -fx-text-fill: #536879;" />
                                            </children>
                                        </VBox>

                                        <!-- Emergency information -->
                                        <HBox spacing="12.0"
                                              alignment="TOP_LEFT"
                                              minHeight="-Infinity"
                                              style="-fx-background-color: #FCECEC;
                                                     -fx-background-radius: 9px;
                                                     -fx-padding: 15px;">

                                            <children>
                                                <Label text="ⓘ"
                                                       style="-fx-font-size: 18px;
                                                              -fx-text-fill: #B33535;" />

                                                <VBox spacing="6.0"
                                                      minWidth="0.0"
                                                      prefWidth="0.0"
                                                      HBox.hgrow="ALWAYS">

                                                    <children>
                                                        <Label
                                                            text="Immediate danger? Call 911"
                                                            wrapText="true"
                                                            minHeight="-Infinity"
                                                            style="-fx-font-size: 13px;
                                                                   -fx-font-weight: bold;
                                                                   -fx-text-fill: #B33535;" />

                                                        <Label
                                                            text="In the US, call 911 when you need immediate police, fire or medical assistance. This app does not dispatch rescue."
                                                            wrapText="true"
                                                            minHeight="-Infinity"
                                                            style="-fx-font-size: 12px;
                                                                   -fx-text-fill: #142D45;
                                                                   -fx-line-spacing: 2px;" />
                                                    </children>
                                                </VBox>
                                            </children>
                                        </HBox>

                                        <Button
                                            text="Call 911 · emergency services"
                                            onAction="#showEmergencyInstructions"
                                            maxWidth="Infinity"
                                            graphicTextGap="10.0"
                                            style="-fx-background-color: #B33535;
                                                   -fx-background-insets: 0;
                                                   -fx-background-radius: 8px;
                                                   -fx-text-fill: white;
                                                   -fx-font-size: 14px;
                                                   -fx-font-weight: bold;
                                                   -fx-min-height: 52px;
                                                   -fx-cursor: hand;">

                                            <graphic>
                                                <SVGPath
                                                    content="M 3 1 L 7 1 L 9 6 L 6 9 C 8 13 11 16 15 18 L 18 15 L 23 17 L 23 21 C 23 26 13 23 7 17 C 1 11 -2 1 3 1 Z"
                                                    fill="TRANSPARENT"
                                                    stroke="WHITE"
                                                    strokeWidth="1.2"
                                                    mouseTransparent="true" />
                                            </graphic>
                                        </Button>

                                        <!-- Checklist -->
                                        <Label
                                            text="Essential safety guidance"
                                            style="-fx-font-size: 19px;
                                                   -fx-font-weight: bold;
                                                   -fx-text-fill: #142D45;" />

                                        <VBox spacing="14.0"
                                              minHeight="-Infinity"
                                              style="-fx-background-color: white;
                                                     -fx-background-radius: 10px;
                                                     -fx-border-color: #DCE5EB;
                                                     -fx-border-radius: 10px;
                                                     -fx-padding: 16px;">

                                            <children>
                                                <Label
                                                    text="HURRICANE CHECKLIST"
                                                    style="-fx-background-color: #E4F3F0;
                                                           -fx-background-radius: 12px;
                                                           -fx-padding: 5px 9px;
                                                           -fx-font-size: 10px;
                                                           -fx-font-weight: bold;
                                                           -fx-text-fill: #087F7A;" />

                                                <Label
                                                    text="• Follow evacuation instructions promptly. Bring essential medicines and plan a route you can use."
                                                    wrapText="true"
                                                    minHeight="-Infinity"
                                                    style="-fx-font-size: 13px;
                                                           -fx-text-fill: #536879;" />

                                                <Label
                                                    text="• Avoid walking or driving through flooded areas."
                                                    wrapText="true"
                                                    minHeight="-Infinity"
                                                    style="-fx-font-size: 13px;
                                                           -fx-text-fill: #536879;" />

                                                <Label
                                                    text="• Run generators outdoors, at least 20 feet from doors, windows and vents."
                                                    wrapText="true"
                                                    minHeight="-Infinity"
                                                    style="-fx-font-size: 13px;
                                                           -fx-text-fill: #536879;" />

                                                <Label
                                                    text="• Follow official updates before returning after an evacuation."
                                                    wrapText="true"
                                                    minHeight="-Infinity"
                                                    style="-fx-font-size: 13px;
                                                           -fx-text-fill: #536879;" />
                                            </children>
                                        </VBox>

                                        <!-- Save checklist -->
                                        <VBox spacing="10.0"
                                              minHeight="-Infinity"
                                              style="-fx-background-color: #E4F3F0;
                                                     -fx-background-radius: 9px;
                                                     -fx-padding: 16px;">

                                            <children>
                                                <Label
                                                    fx:id="offlineTitleLabel"
                                                    text="Offline safety checklist"
                                                    style="-fx-font-size: 13px;
                                                           -fx-font-weight: bold;
                                                           -fx-text-fill: #087F7A;" />

                                                <Label
                                                    fx:id="offlineDescriptionLabel"
                                                    text="Save the checklist to this device. Maps, shelter availability and storm alerts still require current information."
                                                    wrapText="true"
                                                    minHeight="-Infinity"
                                                    style="-fx-font-size: 12px;
                                                           -fx-text-fill: #142D45;" />

                                                <Button
                                                    text="Save checklist"
                                                    onAction="#saveChecklist"
                                                    maxWidth="Infinity"
                                                    style="-fx-background-color: white;
                                                           -fx-background-radius: 7px;
                                                           -fx-text-fill: #087F7A;
                                                           -fx-font-weight: bold;
                                                           -fx-min-height: 42px;
                                                           -fx-cursor: hand;" />
                                            </children>
                                        </VBox>

                                        <!-- Shelter -->
                                        <Label text="Nearby shelters"
                                               style="-fx-font-size: 19px;
                                                      -fx-font-weight: bold;
                                                      -fx-text-fill: #142D45;" />

                                        <VBox spacing="12.0"
                                              minHeight="-Infinity"
                                              style="-fx-background-color: white;
                                                     -fx-background-radius: 10px;
                                                     -fx-border-color: #DCE5EB;
                                                     -fx-border-radius: 10px;
                                                     -fx-padding: 16px;">

                                            <children>
                                                <Label
                                                    text="Riverside Community Center"
                                                    wrapText="true"
                                                    minHeight="-Infinity"
                                                    style="-fx-font-size: 16px;
                                                           -fx-font-weight: bold;
                                                           -fx-text-fill: #142D45;" />

                                                <HBox alignment="CENTER_LEFT">
                                                    <children>
                                                        <Label
                                                            text="Space reported"
                                                            style="-fx-background-color: #E4F3F0;
                                                                   -fx-background-radius: 12px;
                                                                   -fx-padding: 5px 8px;
                                                                   -fx-font-size: 10px;
                                                                   -fx-font-weight: bold;
                                                                   -fx-text-fill: #087F7A;" />

                                                        <Region HBox.hgrow="ALWAYS" />

                                                        <Label text="1.8 mi"
                                                               style="-fx-font-size: 11px;
                                                                      -fx-text-fill: #536879;" />
                                                    </children>
                                                </HBox>

                                                <Label
                                                    text="2100 W River Blvd, Tampa, FL 33607"
                                                    wrapText="true"
                                                    minHeight="-Infinity"
                                                    style="-fx-font-size: 12px;
                                                           -fx-text-fill: #536879;" />

                                                <Label
                                                    text="Step-free entry · Accessible restroom"
                                                    wrapText="true"
                                                    minHeight="-Infinity"
                                                    style="-fx-font-size: 12px;
                                                           -fx-text-fill: #536879;" />

                                                <Label
                                                    text="Pets in carriers accepted"
                                                    wrapText="true"
                                                    minHeight="-Infinity"
                                                    style="-fx-font-size: 12px;
                                                           -fx-text-fill: #536879;" />

                                                <Label
                                                    text="Reported Oct 14 · 9:45 AM EDT"
                                                    style="-fx-font-size: 10px;
                                                           -fx-text-fill: #536879;" />

                                                <Button
                                                    text="Call shelter · (813) 555-0186"
                                                    onAction="#showShelterContact"
                                                    maxWidth="Infinity"
                                                    style="-fx-background-color: white;
                                                           -fx-background-insets: 0;
                                                           -fx-background-radius: 8px;
                                                           -fx-border-color: #DCE5EB;
                                                           -fx-border-radius: 8px;
                                                           -fx-text-fill: #087F7A;
                                                           -fx-font-size: 12px;
                                                           -fx-font-weight: bold;
                                                           -fx-min-height: 48px;
                                                           -fx-cursor: hand;" />
                                            </children>
                                        </VBox>
                                    </children>
                                </VBox>
                            </children>
                        </StackPane>
                    </content>
                </ScrollPane>
            </center>

            <!-- Fixed navigation -->
            <bottom>
                <StackPane
                    style="-fx-background-color: white;
                           -fx-border-color: #DCE5EB transparent transparent transparent;">

                    <children>
                        <HBox alignment="CENTER" maxWidth="390.0">
                            <padding>
                                <Insets top="8.0"
                                        right="10.0"
                                        bottom="10.0"
                                        left="10.0" />
                            </padding>

                            <children>
                                <Button
                                    text="Home"
                                    onAction="#openHome"
                                    contentDisplay="TOP"
                                    graphicTextGap="6.0"
                                    HBox.hgrow="ALWAYS"
                                    minWidth="0.0"
                                    prefWidth="90.0"
                                    maxWidth="Infinity"
                                    style="-fx-background-color: transparent;
                                           -fx-font-size: 10px;
                                           -fx-text-fill: #536879;
                                           -fx-min-height: 54px;
                                           -fx-cursor: hand;">

                                    <graphic>
                                        <SVGPath
                                            content="M 1 10 L 11 1 L 21 10 M 4 8 L 4 21 L 9 21 L 9 14 L 13 14 L 13 21 L 18 21 L 18 8"
                                            fill="TRANSPARENT"
                                            stroke="#536879"
                                            strokeWidth="1.3"
                                            mouseTransparent="true" />
                                    </graphic>
                                </Button>

                                <Button
                                    text="Requests"
                                    onAction="#openRequests"
                                    contentDisplay="TOP"
                                    graphicTextGap="6.0"
                                    HBox.hgrow="ALWAYS"
                                    minWidth="0.0"
                                    prefWidth="90.0"
                                    maxWidth="Infinity"
                                    style="-fx-background-color: transparent;
                                           -fx-font-size: 10px;
                                           -fx-text-fill: #536879;
                                           -fx-min-height: 54px;
                                           -fx-cursor: hand;">

                                    <graphic>
                                        <SVGPath
                                            content="M 5 3 L 2 3 L 2 21 L 18 21 L 18 3 L 15 3 M 5 1 L 15 1 L 15 5 L 5 5 Z M 6 10 L 14 10 M 6 14 L 14 14"
                                            fill="TRANSPARENT"
                                            stroke="#536879"
                                            strokeWidth="1.3"
                                            mouseTransparent="true" />
                                    </graphic>
                                </Button>

                                <Button
                                    text="Safety"
                                    contentDisplay="TOP"
                                    graphicTextGap="6.0"
                                    HBox.hgrow="ALWAYS"
                                    minWidth="0.0"
                                    prefWidth="90.0"
                                    maxWidth="Infinity"
                                    style="-fx-background-color: transparent;
                                           -fx-font-size: 10px;
                                           -fx-font-weight: bold;
                                           -fx-text-fill: #087F7A;
                                           -fx-min-height: 54px;">

                                    <graphic>
                                        <SVGPath
                                            content="M 11 1 L 20 5 L 18 15 L 11 22 L 4 15 L 2 5 Z M 7 11 L 10 14 L 15 8"
                                            fill="TRANSPARENT"
                                            stroke="#087F7A"
                                            strokeWidth="1.3" />
                                    </graphic>
                                </Button>

                                <Button
                                    text="Account"
                                    onAction="#openAccount"
                                    contentDisplay="TOP"
                                    graphicTextGap="6.0"
                                    HBox.hgrow="ALWAYS"
                                    minWidth="0.0"
                                    prefWidth="90.0"
                                    maxWidth="Infinity"
                                    style="-fx-background-color: transparent;
                                           -fx-font-size: 10px;
                                           -fx-text-fill: #536879;
                                           -fx-min-height: 54px;
                                           -fx-cursor: hand;">

                                    <graphic>
                                        <SVGPath
                                            content="M 15 6 A 5 5 0 1 1 5 6 A 5 5 0 1 1 15 6 Z M 1 22 C 1 11 19 11 19 22"
                                            fill="TRANSPARENT"
                                            stroke="#536879"
                                            strokeWidth="1.3"
                                            mouseTransparent="true" />
                                    </graphic>
                                </Button>
                            </children>
                        </HBox>
                    </children>
                </StackPane>
            </bottom>
        </BorderPane>

        <!-- Shared information popup -->
        <StackPane fx:id="informationOverlay"
                   visible="false"
                   managed="false"
                   onKeyPressed="#handleOverlayKey"
                   style="-fx-background-color: rgba(20,45,69,0.30);">

            <padding>
                <Insets top="20.0"
                        right="20.0"
                        bottom="20.0"
                        left="20.0" />
            </padding>

            <children>
                <VBox alignment="CENTER"
                      spacing="18.0"
                      maxWidth="320.0"
                      maxHeight="-Infinity"
                      style="-fx-background-color: #F4F7FA;
                             -fx-background-radius: 16px;
                             -fx-padding: 26px;">

                    <children>
                        <Label fx:id="informationTitleLabel"
                               text="Information"
                               wrapText="true"
                               minHeight="-Infinity"
                               textAlignment="CENTER"
                               style="-fx-font-size: 22px;
                                      -fx-font-weight: bold;
                                      -fx-text-fill: #142D45;" />

                        <Label fx:id="informationMessageLabel"
                               wrapText="true"
                               minHeight="-Infinity"
                               textAlignment="CENTER"
                               style="-fx-font-size: 14px;
                                      -fx-text-fill: #536879;" />

                        <Button fx:id="informationDoneButton"
                                text="Done"
                                onAction="#closeInformation"
                                maxWidth="Infinity"
                                style="-fx-background-color: #087F7A;
                                       -fx-background-radius: 9px;
                                       -fx-text-fill: white;
                                       -fx-font-size: 15px;
                                       -fx-font-weight: bold;
                                       -fx-min-height: 52px;
                                       -fx-cursor: hand;" />
                    </children>
                </VBox>
            </children>
        </StackPane>
    </children>
</StackPane>