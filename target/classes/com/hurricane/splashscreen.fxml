<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.layout.VBox?>

<VBox fx:id="splashRoot"
      styleClass="screen"
      focusTraversable="true"
      stylesheets="@styles.css"
      xmlns="http://javafx.com/javafx/26"
      xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="com.controllers.SplashController">

    <children>
        <Label styleClass="app-name" text="Hurricane Tracker" />
        <Label styleClass="title" text="Welcome to Hurricane Tracker" />
        <Label styleClass="subtitle"
               text="Stay informed, find safety guidance and request non-emergency support for your household." />

        <VBox styleClass="card">
            <children>
                <Label styleClass="card-title" text="Support, one step at a time" />
                <Label styleClass="subtitle"
                       text="Create and track relief requests with an account. Storm updates and safety information are available to everyone." />
            </children>
        </VBox>

        <Button styleClass="primary-button" defaultButton="true"
                onAction="#btnLoginClicked" text="Log in" />
        <Button styleClass="secondary-button"
                onAction="#btnCreateAccountClicked" text="Create account" />
        <Button styleClass="secondary-button"
                onAction="#btnGuestClicked" text="Continue as guest" />

        <VBox styleClass="error-box">
            <children>
                <Label styleClass="error-title" text="Call 911 when in an emergency" />
                <Label styleClass="box-text"
                       text="For immediate danger or medical emergencies, call 911 immediately. Emergency situations should not wait for a relief request to be processed." />
            </children>
        </VBox>
    </children>
</VBox>
