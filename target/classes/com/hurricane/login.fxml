<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.CheckBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.PasswordField?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.VBox?>

<VBox fx:id="loginRoot"
      styleClass="screen"
      focusTraversable="true"
      stylesheets="@styles.css"
      xmlns="http://javafx.com/javafx/26"
      xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="com.controllers.LoginController">

    <children>
        <Button styleClass="back-button" onAction="#back" text="← Back" />

        <Label styleClass="title" text="Log in" />
        <Label styleClass="subtitle" text="Log in to manage your household's relief requests." />

        <VBox fx:id="errorBox" styleClass="error-box" managed="false" visible="false">
            <children>
                <Label styleClass="error-title" text="Email or password doesn't match" />
                <Label styleClass="box-text"
                       text="Check your details and try again, or reset your password. Your saved requests are still there." />
            </children>
        </VBox>

        <Label styleClass="field-label" text="Email address" />
        <TextField fx:id="usernameField" promptText="name@example.com" />

        <Label styleClass="field-label" text="Password" />
        <StackPane>
            <children>
                <PasswordField fx:id="passwordField" promptText="Password" />
                <TextField fx:id="visiblePasswordField" promptText="Password"
                           managed="false" visible="false" />
                <Button fx:id="showPasswordButton" styleClass="eye-button"
                        StackPane.alignment="CENTER_RIGHT"
                        accessibleText="Show password"
                        onAction="#togglePasswordVisibility" text="👁" />
            </children>
        </StackPane>

        <CheckBox text="Keep me signed in on this device." />

        <Button styleClass="primary-button" defaultButton="true"
                onAction="#btnLoginClicked" text="Log in" />
        <Button styleClass="secondary-button" text="Forgot password?" />
        <Button styleClass="secondary-button" onAction="#back" text="Continue as guest" />
    </children>
</VBox>
