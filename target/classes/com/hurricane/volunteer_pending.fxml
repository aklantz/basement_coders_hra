<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.VBox?>

<ScrollPane fitToWidth="true"
            hbarPolicy="NEVER"
            stylesheets="@styles.css"
            xmlns="http://javafx.com/javafx/26"
            xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="com.controllers.VolunteerPendingController">
    <content>
        <VBox styleClass="screen">
            <children>
                <HBox alignment="CENTER_LEFT">
                    <children>
                        <Label styleClass="app-name" text="Hurricane Tracker" />
                        <Region HBox.hgrow="ALWAYS" />
                        <Label styleClass="hint" text="Volunteer" />
                    </children>
                </HBox>

                <Label styleClass="title" text="You’re on the list" />
                <Label styleClass="subtitle" text="Your volunteer application has been submitted." />

                <Label styleClass="tag" text="PENDING APPROVAL" />

                <VBox styleClass="card">
                    <children>
                        <Label styleClass="card-icon" text="🛡" />
                        <Label styleClass="card-title" text="A coordinator reviews new volunteers within 24 hours." />
                        <Label fx:id="emailLabel" styleClass="subtitle"
                               text="We’ll send an update to marcus.johnson@example.com when your account is reviewed." />
                    </children>
                </VBox>

                <Label styleClass="section-title" text="What happens next" />
                <Label styleClass="step-text" text="1   A coordinator reviews your details and skills." />
                <Label styleClass="step-text" text="2   You receive an approval update." />
                <Label styleClass="step-text" text="3   Once approved, you can browse and accept tasks." />

                <Button styleClass="secondary-button" onAction="#btnReviewClicked" text="Review my application" />
                <Button styleClass="secondary-button" onAction="#btnStormUpdatesClicked" text="Back to storm updates" />
            </children>
        </VBox>
    </content>
</ScrollPane>