<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.shape.SVGPath?>

<HBox alignment="CENTER"
      styleClass="nav-bar"
      stylesheets="@styles.css"
      xmlns="http://javafx.com/javafx/26"
      xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="com.controllers.VolunteerNavController">
    <children>
        <Button fx:id="homeButton" styleClass="nav-button" HBox.hgrow="ALWAYS"
                onAction="#goHome" text="Home">
            <graphic>
                <SVGPath styleClass="nav-icon" mouseTransparent="true"
                         content="M 1 10 L 11 1 L 21 10 M 4 8 L 4 21 L 9 21 L 9 14 L 13 14 L 13 21 L 18 21 L 18 8" />
            </graphic>
        </Button>

        <Button fx:id="tasksButton" styleClass="nav-button" HBox.hgrow="ALWAYS"
                onAction="#goTasks" text="Tasks">
            <graphic>
                <SVGPath styleClass="nav-icon" mouseTransparent="true"
                         content="M 5 3 L 2 3 L 2 21 L 18 21 L 18 3 L 15 3 M 5 1 L 15 1 L 15 5 L 5 5 Z M 6 10 L 14 10 M 6 14 L 14 14" />
            </graphic>
        </Button>

        <Button fx:id="sheltersButton" styleClass="nav-button" HBox.hgrow="ALWAYS"
                onAction="#goShelters" text="Shelters">
            <graphic>
                <SVGPath styleClass="nav-icon" mouseTransparent="true"
                         content="M 11 1 L 20 5 L 18 15 L 11 22 L 4 15 L 2 5 Z M 7 11 L 10 14 L 15 8" />
            </graphic>
        </Button>

        <Button fx:id="accountButton" styleClass="nav-button" HBox.hgrow="ALWAYS"
                onAction="#goAccount" text="Account">
            <graphic>
                <SVGPath styleClass="nav-icon" mouseTransparent="true"
                         content="M 15 6 A 5 5 0 1 1 5 6 A 5 5 0 1 1 15 6 Z M 1 22 C 1 11 19 11 19 22" />
            </graphic>
        </Button>
    </children>
</HBox>