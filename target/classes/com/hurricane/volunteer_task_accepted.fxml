<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.shape.SVGPath?>

<BorderPane stylesheets="@styles.css"
            xmlns="http://javafx.com/javafx/26"
            xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="com.controllers.VolunteerTaskAcceptedController">
    <center>
        <ScrollPane fitToWidth="true" hbarPolicy="NEVER">
            <content>
                <VBox styleClass="screen">
                    <children>
                        <HBox alignment="CENTER_LEFT">
                            <children>
                                <Button styleClass="back-button" onAction="#back" text="← Back" />
                                <Region HBox.hgrow="ALWAYS" />
                                <Label styleClass="hint" text="Volunteer" />
                            </children>
                        </HBox>

                        <Label styleClass="title" text="Task accepted" />
                        <Label styleClass="subtitle" text="HT-261014-082 · Elena’s household" />
                        <Label styleClass="tag" text="ACCEPTED · READY TO START" />

                        <VBox styleClass="card">
                            <children>
                                <SVGPath fill="TRANSPARENT" stroke="#0b7f79" strokeWidth="1.3"
                                         mouseTransparent="true"
                                         content="M 8 1 C 4 1 1 4 1 8 C 1 12 8 19 8 19 C 8 19 15 12 15 8 C 15 4 12 1 8 1 Z M 8 5.5 A 2.5 2.5 0 1 1 7.99 5.5 Z" />
                                <Label styleClass="card-title" text="2418 N Willow Ave" />
                                <Label styleClass="subtitle" text="Tampa, FL 33607" />
                                <Label styleClass="card-title" text="Access notes" />
                                <Label styleClass="subtitle"
                                       text="Meet at the front gate. Call before arriving. Do not enter the house. One older adult uses a cane." />
                            </children>
                        </VBox>

                        <VBox styleClass="card">
                            <children>
                                <Label styleClass="card-title" text="Elena Morales" />
                                <Label styleClass="subtitle" text="(813) 555-0142 · SMS · 8 AM–8 PM EDT" />
                                <Label styleClass="hint" text="Text before calling · No voicemail" />
                            </children>
                        </VBox>

                        <Label styleClass="hint"
                               text="Deliver: water, ready-to-eat food and a portable phone charger." />

                        <Button styleClass="primary-button" onAction="#btnDirectionsClicked" text="Directions" />
                        <Button styleClass="secondary-button" onAction="#btnStartClicked" text="Start" />
                    </children>
                </VBox>
            </content>
        </ScrollPane>
    </center>

    <bottom>
        <fx:include fx:id="volunteerNav" source="volunteer_nav.fxml" />
    </bottom>
</BorderPane>