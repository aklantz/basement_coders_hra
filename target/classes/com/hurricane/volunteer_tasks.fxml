<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.control.ToggleButton?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.shape.SVGPath?>

<BorderPane stylesheets="@styles.css"
            xmlns="http://javafx.com/javafx/26"
            xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="com.controllers.VolunteerTasksController">
    <center>
        <ScrollPane fitToWidth="true" hbarPolicy="NEVER">
            <content>
                <VBox styleClass="screen">
                    <children>
                        <HBox alignment="CENTER_LEFT" spacing="8.0">
                            <children>
                                <SVGPath fill="TRANSPARENT" stroke="#087F7A" strokeWidth="1.2"
                                         mouseTransparent="true"
                                         content="M 12 2 C 5 2 1 7 2 13 C 3 20 10 24 17 20 M 21 4 C 15 0 7 4 6 11 C 5 17 12 21 17 16 C 21 12 17 6 12 8 C 8 10 10 15 14 14" />
                                <Label styleClass="app-name" text="Hurricane Tracker" />
                                <Region HBox.hgrow="ALWAYS" />
                                <Label styleClass="hint" text="Volunteer" />
                            </children>
                        </HBox>

                        <Label styleClass="title" text="My tasks" />
                        <Label styleClass="subtitle" text="Keep track of the help you’re providing." />

                        <HBox styleClass="segment">
                            <children>
                                <ToggleButton fx:id="activeButton" styleClass="segment-button"
                                              HBox.hgrow="ALWAYS" onAction="#showActive" text="Active (1)" />
                                <ToggleButton fx:id="completedButton" styleClass="segment-button"
                                              HBox.hgrow="ALWAYS" onAction="#showCompleted" text="Completed" />
                            </children>
                        </HBox>

                        <VBox fx:id="activeList" spacing="14.0">
                            <children>
                                <VBox styleClass="card">
                                    <children>
                                        <Label styleClass="tag" text="ACCEPTED" />
                                        <Label styleClass="card-title" text="Food &amp; water" />
                                        <Label styleClass="subtitle" text="Elena’s household · 3 people" />
                                        <Label styleClass="hint" text="HT-261014-082 · ZIP 33607" />
                                        <Label styleClass="hint" text="Needed today · 12 min drive" />
                                        <Button styleClass="primary-button" onAction="#btnViewTaskClicked" text="View task" />
                                    </children>
                                </VBox>

                                <VBox styleClass="card">
                                    <children>
                                        <Label styleClass="card-title" text="Waiting for confirmation?" />
                                        <Label styleClass="subtitle"
                                               text="A submitted delivery stays active until the resident or coordinator confirms it." />
                                    </children>
                                </VBox>
                            </children>
                        </VBox>

                        <VBox fx:id="completedList" spacing="14.0" managed="false" visible="false">
                            <children>
                                <VBox styleClass="card">
                                    <children>
                                        <Label styleClass="tag" text="COMPLETED" />
                                        <Label styleClass="card-title" text="Supplies delivery" />
                                        <Label styleClass="subtitle" text="Jordan’s household · ZIP 33609" />
                                        <Label styleClass="hint" text="HT-261013-064" />
                                        <Label styleClass="hint" text="Completed Oct 13 · 3:40 PM" />
                                        <Label styleClass="confirm-text" text="Receipt confirmed by resident" />
                                        <Button styleClass="secondary-button" text="View completed task" />
                                    </children>
                                </VBox>

                                <Label styleClass="hint" text="Thank you for showing up for your neighbors." />
                            </children>
                        </VBox>

                        <!-- Empty state -->
                        <VBox fx:id="emptyList" styleClass="card" alignment="CENTER" managed="false" visible="false">
                            <children>
                                <Label styleClass="card-title" textAlignment="CENTER" text="No active tasks yet" />
                                <Label styleClass="subtitle" textAlignment="CENTER"
                                       text="When you accept a request, it will appear here so you can follow it through to completion." />
                                <Button styleClass="primary-button" onAction="#btnBrowseClicked" text="Browse recommended requests" />
                            </children>
                        </VBox>
                    </children>
                </VBox>
            </content>
        </ScrollPane>
    </center>

    <bottom>
        <fx:include fx:id="volunteerNav" source="volunteer_nav.fxml" />
    </bottom>
</BorderPane>