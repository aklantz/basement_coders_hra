<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<StackPane fx:id="requestRoot"
           prefWidth="390.0"
           prefHeight="800.0"
           focusTraversable="true"
           xmlns="http://javafx.com/javafx/13"
           xmlns:fx="http://javafx.com/fxml/1"
           fx:controller="com.controllers.RequestReliefController"
           style="-fx-background-color: #F4F7FA;
                  -fx-font-family: 'Segoe UI';
                  -fx-font-size: 14px;
                  -fx-accent: #008681;
                  -fx-focus-color: #008681;">

    <fx:define>
        <ToggleGroup fx:id="urgencyGroup" />
        <ToggleGroup fx:id="contactGroup" />
    </fx:define>

    <children>
        <ScrollPane fx:id="wizardScroll"
                    fitToWidth="true"
                    hbarPolicy="NEVER"
                    style="-fx-background: #F4F7FA;
                           -fx-background-color: #F4F7FA;
                           -fx-padding: 0;
                           -fx-background-insets: 0;">
            <content>
                <StackPane alignment="TOP_CENTER">
                    <children>
                        <VBox spacing="21.0"
                              maxWidth="390.0"
                              minHeight="-Infinity">

                            <padding>
                                <Insets top="20.0"
                                        right="22.0"
                                        bottom="28.0"
                                        left="22.0" />
                            </padding>

                            <children>
                                <!-- Shared navigation -->
                                <HBox fx:id="navigationBar"
                                      alignment="CENTER_LEFT">
                                    <children>
                                        <Button text="←  Back"
                                                onAction="#back"
                                                style="-fx-background-color: transparent;
                                                       -fx-text-fill: #587083;
                                                       -fx-padding: 4px 0;
                                                       -fx-cursor: hand;" />

                                        <Region HBox.hgrow="ALWAYS" />

                                        <Hyperlink text="Save &amp; exit"
                                                   onAction="#saveDraftAndExit"
                                                   style="-fx-text-fill: #587083;
                                                          -fx-font-size: 11px;" />
                                    </children>
                                </HBox>

                                <Label fx:id="stepLabel"
                                       text="Step 1 of 4 · Needs"
                                       wrapText="true"
                                       minHeight="-Infinity"
                                       style="-fx-font-size: 13px;
                                              -fx-text-fill: #587083;" />

                                <!-- Form progress -->
                                <HBox fx:id="progressSteps"
                                      spacing="8.0">
                                    <children>
                                        <VBox spacing="6.0"
                                              HBox.hgrow="ALWAYS"
                                              prefWidth="0.0">
                                            <children>
                                                <Region fx:id="segment0"
                                                        minHeight="4.0"
                                                        prefHeight="4.0"
                                                        style="-fx-background-color: #D8E3EB;" />

                                                <Label text="Needs"
                                                       style="-fx-font-size: 10px; -fx-text-fill: #587083;" />
                                            </children>
                                        </VBox>

                                        <VBox spacing="6.0"
                                              HBox.hgrow="ALWAYS"
                                              prefWidth="0.0">
                                            <children>
                                                <Region fx:id="segment1"
                                                        minHeight="4.0"
                                                        prefHeight="4.0"
                                                        style="-fx-background-color: #D8E3EB;" />

                                                <Label text="Household"
                                                       style="-fx-font-size: 10px; -fx-text-fill: #587083;" />
                                            </children>
                                        </VBox>

                                        <VBox spacing="6.0"
                                              HBox.hgrow="ALWAYS"
                                              prefWidth="0.0">
                                            <children>
                                                <Region fx:id="segment2"
                                                        minHeight="4.0"
                                                        prefHeight="4.0"
                                                        style="-fx-background-color: #D8E3EB;" />

                                                <Label text="Location"
                                                       style="-fx-font-size: 10px; -fx-text-fill: #587083;" />
                                            </children>
                                        </VBox>

                                        <VBox spacing="6.0"
                                              HBox.hgrow="ALWAYS"
                                              prefWidth="0.0">
                                            <children>
                                                <Region fx:id="segment3"
                                                        minHeight="4.0"
                                                        prefHeight="4.0"
                                                        style="-fx-background-color: #D8E3EB;" />

                                                <Label text="Contact"
                                                       style="-fx-font-size: 10px; -fx-text-fill: #587083;" />
                                            </children>
                                        </VBox>
                                    </children>
                                </HBox>

                                <Label fx:id="draftNotice"
                                       visible="false"
                                       managed="false"
                                       wrapText="true"
                                       minHeight="-Infinity"
                                       style="-fx-font-size: 12px; -fx-text-fill: #008681;" />

                                <!-- Confirmation header -->
                                <HBox fx:id="submissionBrand"
                                      alignment="CENTER_LEFT"
                                      spacing="8.0"
                                      visible="false"
                                      managed="false">
                                    <children>
                                        <Label text="◉"
                                               style="-fx-font-size: 20px; -fx-text-fill: #008681;" />

                                        <Label text="Hurricane Tracker"
                                               style="-fx-font-size: 12px; -fx-text-fill: #142D45;" />

                                        <Region HBox.hgrow="ALWAYS" />

                                        <Label fx:id="submissionLocation"
                                               wrapText="true"
                                               minHeight="-Infinity"
                                               maxWidth="130.0"
                                               style="-fx-font-size: 10px; -fx-text-fill: #587083;" />
                                    </children>
                                </HBox>

                                <!-- Shared page heading -->
                                <VBox spacing="7.0">
                                    <children>
                                        <Label fx:id="pageTitle"
                                               text="Needs"
                                               wrapText="true"
                                               minHeight="-Infinity"
                                               style="-fx-font-size: 27px;
                                                      -fx-font-weight: bold;
                                                      -fx-text-fill: #142D45;" />

                                        <Label fx:id="pageSubtitle"
                                               text="Choose the supplies you need and how soon. * Required."
                                               wrapText="true"
                                               minHeight="-Infinity"
                                               style="-fx-font-size: 14px; -fx-text-fill: #587083;" />
                                    </children>
                                </VBox>

                                <!-- Validation banner -->
                                <VBox fx:id="errorBanner"
                                      visible="false"
                                      managed="false"
                                      spacing="6.0"
                                      minHeight="-Infinity"
                                      style="-fx-background-color: #FCEBEC;
                                             -fx-background-radius: 8px;
                                             -fx-padding: 14px;">
                                    <children>
                                        <Label fx:id="errorHeading"
                                               text="Check the highlighted fields"
                                               wrapText="true"
                                               minHeight="-Infinity"
                                               style="-fx-font-size: 13px; -fx-font-weight: bold; -fx-text-fill: #B52E37;" />

                                        <Label fx:id="errorText"
                                               wrapText="true"
                                               minHeight="-Infinity"
                                               style="-fx-font-size: 12px; -fx-text-fill: #142D45;" />
                                    </children>
                                </VBox>

                                <!-- STEP 1: NEEDS -->
                                <VBox fx:id="needsPage"
                                      spacing="19.0"
                                      minHeight="-Infinity">
                                    <children>
                                        <VBox spacing="5.0"
                                              minHeight="-Infinity"
                                              style="-fx-padding: 14px; -fx-background-color: #FCEBEC; -fx-background-radius: 8px;">
                                            <children>
                                                <Label text="ⓘ  Immediate danger is an emergency"
                                                       wrapText="true"
                                                       minHeight="-Infinity"
                                                       style="-fx-font-size: 13px; -fx-font-weight: bold; -fx-text-fill: #B52E37;" />

                                                <Label text="Call 911 in the US for immediate danger or urgent medical care. Do not wait for a relief request."
                                                       wrapText="true"
                                                       minHeight="-Infinity"
                                                       style="-fx-font-size: 12px; -fx-text-fill: #142D45;" />
                                            </children>
                                        </VBox>

                                        <VBox spacing="8.0">
                                            <children>
                                                <Label text="Needs *"
                                                       style="-fx-font-size: 13px; -fx-font-weight: bold; -fx-text-fill: #142D45;" />

                                                <CheckBox fx:id="waterNeed"
                                                          text="Drinking water"
                                                          wrapText="true"
                                                          minHeight="52.0"
                                                          maxWidth="Infinity"
                                                          style="-fx-text-fill: #142D45; -fx-font-size: 13px; -fx-padding: 12px; -fx-background-color: white; -fx-background-radius: 8px; -fx-border-radius: 8px; -fx-border-color: #D8E3EB; -fx-cursor: hand;" />

                                                <CheckBox fx:id="foodNeed"
                                                          text="Food"
                                                          wrapText="true"
                                                          minHeight="52.0"
                                                          maxWidth="Infinity"
                                                          style="-fx-text-fill: #142D45; -fx-font-size: 13px; -fx-padding: 12px; -fx-background-color: white; -fx-background-radius: 8px; -fx-border-radius: 8px; -fx-border-color: #D8E3EB; -fx-cursor: hand;" />

                                                <CheckBox fx:id="shelterNeed"
                                                          text="Temporary shelter"
                                                          wrapText="true"
                                                          minHeight="52.0"
                                                          maxWidth="Infinity"
                                                          style="-fx-text-fill: #142D45; -fx-font-size: 13px; -fx-padding: 12px; -fx-background-color: white; -fx-background-radius: 8px; -fx-border-radius: 8px; -fx-border-color: #D8E3EB; -fx-cursor: hand;" />

                                                <CheckBox fx:id="medicalNeed"
                                                          text="Medical supplies"
                                                          wrapText="true"
                                                          minHeight="52.0"
                                                          maxWidth="Infinity"
                                                          style="-fx-text-fill: #142D45; -fx-font-size: 13px; -fx-padding: 12px; -fx-background-color: white; -fx-background-radius: 8px; -fx-border-radius: 8px; -fx-border-color: #D8E3EB; -fx-cursor: hand;" />

                                                <CheckBox fx:id="transportNeed"
                                                          text="Transport"
                                                          wrapText="true"
                                                          minHeight="52.0"
                                                          maxWidth="Infinity"
                                                          style="-fx-text-fill: #142D45; -fx-font-size: 13px; -fx-padding: 12px; -fx-background-color: white; -fx-background-radius: 8px; -fx-border-radius: 8px; -fx-border-color: #D8E3EB; -fx-cursor: hand;" />

                                                <CheckBox fx:id="otherNeed"
                                                          text="Other essentials"
                                                          wrapText="true"
                                                          minHeight="52.0"
                                                          maxWidth="Infinity"
                                                          style="-fx-text-fill: #142D45; -fx-font-size: 13px; -fx-padding: 12px; -fx-background-color: white; -fx-background-radius: 8px; -fx-border-radius: 8px; -fx-border-color: #D8E3EB; -fx-cursor: hand;" />
                                            </children>
                                        </VBox>

                                        <VBox fx:id="otherGroup"
                                              spacing="8.0"
                                              visible="false"
                                              managed="false">
                                            <children>
                                                <Label text="Other essentials *"
                                                       style="-fx-font-size: 13px; -fx-font-weight: bold; -fx-text-fill: #142D45;" />

                                                <TextField fx:id="otherField"
                                                           promptText="Describe other supplies"
                                                           minHeight="48.0"
                                                           style="-fx-background-color: white; -fx-background-insets: 0; -fx-background-radius: 8px; -fx-border-color: #D8E3EB; -fx-border-radius: 8px; -fx-padding: 12px; -fx-font-size: 14px; -fx-text-fill: #142D45;" />
                                            </children>
                                        </VBox>

                                        <VBox spacing="8.0">
                                            <children>
                                                <Label text="How soon is support needed? *"
                                                       wrapText="true"
                                                       minHeight="-Infinity"
                                                       style="-fx-font-size: 13px; -fx-font-weight: bold; -fx-text-fill: #142D45;" />

                                                <RadioButton fx:id="todayRadio"
                                                             text="Today · essential supplies are low&#10;Non-emergency; no response time is promised"
                                                             toggleGroup="$urgencyGroup"
                                                             wrapText="true"
                                                             minHeight="62.0"
                                                             maxWidth="Infinity"
                                                             style="-fx-text-fill: #142D45; -fx-font-size: 13px; -fx-padding: 12px; -fx-background-color: white; -fx-background-radius: 8px; -fx-border-radius: 8px; -fx-border-color: #D8E3EB; -fx-cursor: hand;" />

                                                <RadioButton fx:id="laterRadio"
                                                             text="Within the next few days&#10;We have enough essentials for now"
                                                             toggleGroup="$urgencyGroup"
                                                             wrapText="true"
                                                             minHeight="62.0"
                                                             maxWidth="Infinity"
                                                             style="-fx-text-fill: #142D45; -fx-font-size: 13px; -fx-padding: 12px; -fx-background-color: white; -fx-background-radius: 8px; -fx-border-radius: 8px; -fx-border-color: #D8E3EB; -fx-cursor: hand;" />
                                            </children>
                                        </VBox>

                                        <Label text="Urgency helps coordinators understand your situation. It does not prioritize emergency rescue."
                                               wrapText="true"
                                               minHeight="-Infinity"
                                               style="-fx-font-size: 11px; -fx-text-fill: #587083;" />
                                    </children>
                                </VBox>

                                <!-- STEP 2: HOUSEHOLD -->
                                <VBox fx:id="householdPage"
                                      spacing="19.0"
                                      visible="false"
                                      managed="false"
                                      minHeight="-Infinity">
                                    <children>
                                        <VBox spacing="8.0">
                                            <children>
                                                <Label text="People needing support *"
                                                       style="-fx-font-size: 13px; -fx-font-weight: bold; -fx-text-fill: #142D45;" />

                                                <TextField fx:id="peopleField"
                                                           promptText="For example, 3"
                                                           minHeight="48.0"
                                                           style="-fx-background-color: white; -fx-background-insets: 0; -fx-background-radius: 8px; -fx-border-color: #D8E3EB; -fx-border-radius: 8px; -fx-padding: 12px; -fx-font-size: 14px; -fx-text-fill: #142D45;" />

                                                <Label text="Include yourself. Do not list household members’ names."
                                                       wrapText="true"
                                                       minHeight="-Infinity"
                                                       style="-fx-font-size: 11px; -fx-text-fill: #587083;" />
                                            </children>
                                        </VBox>

                                        <HBox spacing="12.0">
                                            <children>
                                                <VBox spacing="8.0"
                                                      HBox.hgrow="ALWAYS"
                                                      prefWidth="0.0">
                                                    <children>
                                                        <Label text="Children under 18"
                                                               wrapText="true"
                                                               minHeight="-Infinity"
                                                               style="-fx-font-size: 12px; -fx-font-weight: bold; -fx-text-fill: #142D45;" />

                                                        <TextField fx:id="childrenField"
                                                                   text="0"
                                                                   minHeight="48.0"
                                                                   style="-fx-background-color: white; -fx-background-insets: 0; -fx-background-radius: 8px; -fx-border-color: #D8E3EB; -fx-border-radius: 8px; -fx-padding: 12px; -fx-font-size: 14px; -fx-text-fill: #142D45;" />
                                                    </children>
                                                </VBox>

                                                <VBox spacing="8.0"
                                                      HBox.hgrow="ALWAYS"
                                                      prefWidth="0.0">
                                                    <children>
                                                        <Label text="Adults 65 or older"
                                                               wrapText="true"
                                                               minHeight="-Infinity"
                                                               style="-fx-font-size: 12px; -fx-font-weight: bold; -fx-text-fill: #142D45;" />

                                                        <TextField fx:id="olderField"
                                                                   text="0"
                                                                   minHeight="48.0"
                                                                   style="-fx-background-color: white; -fx-background-insets: 0; -fx-background-radius: 8px; -fx-border-color: #D8E3EB; -fx-border-radius: 8px; -fx-padding: 12px; -fx-font-size: 14px; -fx-text-fill: #142D45;" />
                                                    </children>
                                                </VBox>
                                            </children>
                                        </HBox>

                                        <VBox spacing="8.0">
                                            <children>
                                                <Label text="Accessibility or medical supply needs · optional"
                                                       wrapText="true"
                                                       minHeight="-Infinity"
                                                       style="-fx-font-size: 13px; -fx-font-weight: bold; -fx-text-fill: #142D45;" />

                                                <TextArea fx:id="accessibilityField"
                                                          promptText="Describe mobility or medical supply needs"
                                                          wrapText="true"
                                                          prefRowCount="3"
                                                          style="-fx-background-color: white; -fx-background-insets: 0; -fx-background-radius: 8px; -fx-border-color: #D8E3EB; -fx-border-radius: 8px; -fx-padding: 12px; -fx-font-size: 14px; -fx-text-fill: #142D45;" />
                                            </children>
                                        </VBox>

                                        <VBox spacing="8.0">
                                            <children>
                                                <Label text="Describe your situation *"
                                                       style="-fx-font-size: 13px; -fx-font-weight: bold; -fx-text-fill: #142D45;" />

                                                <TextArea fx:id="situationField"
                                                          promptText="Tell us what your household needs"
                                                          wrapText="true"
                                                          prefRowCount="4"
                                                          style="-fx-background-color: white; -fx-background-insets: 0; -fx-background-radius: 8px; -fx-border-color: #D8E3EB; -fx-border-radius: 8px; -fx-padding: 12px; -fx-font-size: 14px; -fx-text-fill: #142D45;" />
                                            </children>
                                        </VBox>

                                        <Label fx:id="characterCount"
                                               text="0 / 500 characters"
                                               style="-fx-font-size: 11px; -fx-text-fill: #587083;" />
                                    </children>
                                </VBox>

                                <!-- STEP 3: LOCATION -->
                                <VBox fx:id="locationPage"
                                      spacing="19.0"
                                      visible="false"
                                      managed="false"
                                      minHeight="-Infinity">
                                    <children>
                                        <VBox spacing="8.0">
                                            <children>
                                                <Label text="Street address *"
                                                       style="-fx-font-size: 13px; -fx-font-weight: bold; -fx-text-fill: #142D45;" />

                                                <TextField fx:id="streetField"
                                                           promptText="Street address"
                                                           minHeight="48.0"
                                                           style="-fx-background-color: white; -fx-background-insets: 0; -fx-background-radius: 8px; -fx-border-color: #D8E3EB; -fx-border-radius: 8px; -fx-padding: 12px; -fx-font-size: 14px; -fx-text-fill: #142D45;" />
                                            </children>
                                        </VBox>

                                        <VBox spacing="8.0">
                                            <children>
                                                <Label text="City, state and ZIP *"
                                                       style="-fx-font-size: 13px; -fx-font-weight: bold; -fx-text-fill: #142D45;" />

                                                <TextField fx:id="cityField"
                                                           promptText="City, state and ZIP"
                                                           minHeight="48.0"
                                                           style="-fx-background-color: white; -fx-background-insets: 0; -fx-background-radius: 8px; -fx-border-color: #D8E3EB; -fx-border-radius: 8px; -fx-padding: 12px; -fx-font-size: 14px; -fx-text-fill: #142D45;" />
                                            </children>
                                        </VBox>

                                        <VBox spacing="8.0">
                                            <children>
                                                <Label text="Access or safe pickup instructions *"
                                                       wrapText="true"
                                                       minHeight="-Infinity"
                                                       style="-fx-font-size: 13px; -fx-font-weight: bold; -fx-text-fill: #142D45;" />

                                                <TextArea fx:id="instructionsField"
                                                          promptText="Where can support safely meet you?"
                                                          wrapText="true"
                                                          prefRowCount="3"
                                                          style="-fx-background-color: white; -fx-background-insets: 0; -fx-background-radius: 8px; -fx-border-color: #D8E3EB; -fx-border-radius: 8px; -fx-padding: 12px; -fx-font-size: 14px; -fx-text-fill: #142D45;" />

                                                <Label text="Describe a landmark or meeting point. Do not share door codes."
                                                       wrapText="true"
                                                       minHeight="-Infinity"
                                                       style="-fx-font-size: 11px; -fx-text-fill: #587083;" />
                                            </children>
                                        </VBox>

                                        <CheckBox fx:id="safeLocation"
                                                  text="I can safely meet at this location"
                                                  wrapText="true"
                                                  minHeight="52.0"
                                                  maxWidth="Infinity"
                                                  style="-fx-text-fill: #142D45; -fx-font-size: 13px; -fx-padding: 12px; -fx-background-color: white; -fx-background-radius: 8px; -fx-border-radius: 8px; -fx-border-color: #D8E3EB; -fx-cursor: hand;" />

                                        <Label text="If conditions change, update your request."
                                               wrapText="true"
                                               minHeight="-Infinity"
                                               style="-fx-font-size: 11px; -fx-text-fill: #587083;" />
                                    </children>
                                </VBox>

                                <!-- STEP 4: CONTACT -->
                                <VBox fx:id="contactPage"
                                      spacing="19.0"
                                      visible="false"
                                      managed="false"
                                      minHeight="-Infinity">
                                    <children>
                                        <VBox spacing="8.0">
                                            <children>
                                                <Label text="Preferred safe contact *"
                                                       style="-fx-font-size: 13px; -fx-font-weight: bold; -fx-text-fill: #142D45;" />

                                                <RadioButton fx:id="smsRadio"
                                                             text="Text message (SMS)&#10;Only request-related messages; carrier fees may apply"
                                                             toggleGroup="$contactGroup"
                                                             wrapText="true"
                                                             minHeight="62.0"
                                                             maxWidth="Infinity"
                                                             style="-fx-text-fill: #142D45; -fx-font-size: 13px; -fx-padding: 12px; -fx-background-color: white; -fx-background-radius: 8px; -fx-border-radius: 8px; -fx-border-color: #D8E3EB; -fx-cursor: hand;" />

                                                <RadioButton fx:id="phoneRadio"
                                                             text="Phone call"
                                                             toggleGroup="$contactGroup"
                                                             wrapText="true"
                                                             minHeight="62.0"
                                                             maxWidth="Infinity"
                                                             style="-fx-text-fill: #142D45; -fx-font-size: 13px; -fx-padding: 12px; -fx-background-color: white; -fx-background-radius: 8px; -fx-border-radius: 8px; -fx-border-color: #D8E3EB; -fx-cursor: hand;" />
                                            </children>
                                        </VBox>

                                        <VBox spacing="8.0">
                                            <children>
                                                <Label text="Contact phone number *"
                                                       style="-fx-font-size: 13px; -fx-font-weight: bold; -fx-text-fill: #142D45;" />

                                                <TextField fx:id="phoneField"
                                                           promptText="(813) 555-0142"
                                                           minHeight="48.0"
                                                           style="-fx-background-color: white; -fx-background-insets: 0; -fx-background-radius: 8px; -fx-border-color: #D8E3EB; -fx-border-radius: 8px; -fx-padding: 12px; -fx-font-size: 14px; -fx-text-fill: #142D45;" />
                                            </children>
                                        </VBox>

                                        <Label fx:id="phoneError"
                                               text="Enter a 10-digit US phone number, including area code. For example: (813) 555-0142."
                                               visible="false"
                                               managed="false"
                                               wrapText="true"
                                               minHeight="-Infinity"
                                               style="-fx-font-size: 11px; -fx-text-fill: #C03540;" />

                                        <VBox spacing="8.0">
                                            <children>
                                                <Label text="When is it safe to contact you? *"
                                                       wrapText="true"
                                                       minHeight="-Infinity"
                                                       style="-fx-font-size: 13px; -fx-font-weight: bold; -fx-text-fill: #142D45;" />

                                                <TextField fx:id="safeTimeField"
                                                           promptText="For example, 8 AM–8 PM · Text first · No voicemail"
                                                           minHeight="48.0"
                                                           style="-fx-background-color: white; -fx-background-insets: 0; -fx-background-radius: 8px; -fx-border-color: #D8E3EB; -fx-border-radius: 8px; -fx-padding: 12px; -fx-font-size: 14px; -fx-text-fill: #142D45;" />
                                            </children>
                                        </VBox>

                                        <VBox spacing="5.0"
                                              minHeight="-Infinity"
                                              style="-fx-padding: 14px; -fx-background-color: #FFF3DC; -fx-background-radius: 8px;">
                                            <children>
                                                <Label text="⚠  Submitting is not a guarantee"
                                                       wrapText="true"
                                                       minHeight="-Infinity"
                                                       style="-fx-font-size: 13px; -fx-font-weight: bold; -fx-text-fill: #95600A;" />

                                                <Label text="Drafts are not submitted until you send them. Assistance and timing are not guaranteed. Contact and location details are included with your request."
                                                       wrapText="true"
                                                       minHeight="-Infinity"
                                                       style="-fx-font-size: 12px; -fx-text-fill: #142D45;" />
                                            </children>
                                        </VBox>
                                    </children>
                                </VBox>

                                <!-- REVIEW AND SUBMIT -->
                                <VBox fx:id="reviewPage"
