<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.VBox?>

<ScrollPane fitToWidth="true"
            hbarPolicy="NEVER"
            stylesheets="@styles.css"
            xmlns="http://javafx.com/javafx/26"
            xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="com.controllers.VolunteerDirectionsController">
    <content>
        <VBox styleClass="screen">
            <children>
                <HBox alignment="CENTER_LEFT">
                    <children>
                        <Button styleClass="back-button" onAction="#back" text="← Back" />
                        <Region HBox.hgrow="ALWAYS" />
                        <Label styleClass="hint" text="Volunteer" />
                    </children>
                </HBox>

                <Label styleClass="title" text="Directions to Elena" />
                <Label styleClass="subtitle" text="HT-261014-082 · Delivery in progress" />

                <VBox styleClass="card">
                    <children>
                        <Label styleClass="tag" text="DRIVING · TASK STARTED" />
                        <Label styleClass="big-text" text="12 min drive" />
                        <Label styleClass="subtitle" text="2418 N Willow Ave&#10;Tampa, FL 33607" />
                    </children>
                </VBox>

                <VBox styleClass="card">
                    <children>
                        <Label styleClass="step-text" text="1   Head east toward N Willow Ave · 0.7 mi" />
                        <Label styleClass="step-text" text="2   Turn right onto N Willow Ave · 1.2 mi" />
                        <Label styleClass="step-text" text="3   Stop at 2418 · Meet at the front gate" />
                    </children>
                </VBox>

                <Label styleClass="hint"
                       text="Call before arriving. Do not enter the house. Follow road closures and never drive through floodwater." />

                <Button styleClass="primary-button" onAction="#btnArrivedClicked" text="I’ve arrived" />
                <Button styleClass="secondary-button" onAction="#btnDetailsClicked" text="View task details" />
            </children>
        </VBox>
    </content>
</ScrollPane>