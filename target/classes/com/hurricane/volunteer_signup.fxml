<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.PasswordField?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.VBox?>

<ScrollPane fitToWidth="true"
            hbarPolicy="NEVER"
            stylesheets="@styles.css"
            xmlns="http://javafx.com/javafx/26"
            xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="com.controllers.VolunteerSignupController">
    <content>
        <VBox styleClass="screen">
            <children>
                <HBox alignment="CENTER_LEFT">
                    <children>
                        <Button styleClass="back-button" onAction="#back" text="← Back" />
                        <Region HBox.hgrow="ALWAYS" />
                        <Label styleClass="hint" text="Volunteer" />
                    </children>
                </HBox>

                <Label styleClass="title" text="Become a volunteer" />
                <Label styleClass="subtitle" text="Help your neighbors recover, one task at a time." />

                <VBox fx:id="errorBox" styleClass="error-box" managed="false" visible="false">
                    <children>
                        <Label fx:id="lbl_error" styleClass="error-title" />
                    </children>
                </VBox>

                <Label styleClass="field-label" text="Full name *" />
                <TextField fx:id="fullNameField" promptText="Marcus Johnson" />

                <Label styleClass="field-label" text="Email address *" />
                <TextField fx:id="emailField" promptText="marcus.johnson@example.com" />

                <Label styleClass="field-label" text="Mobile phone *" />
                <TextField fx:id="phoneField" promptText="(813) 555-0168" />

                <Label styleClass="field-label" text="Service ZIP codes *" />
                <TextField fx:id="zipField" promptText="33607, 33609" />
                <Label styleClass="hint" text="Use commas to separate the areas you can serve." />

                <Label styleClass="field-label" text="Password *" />
                <StackPane>
                    <children>
                        <PasswordField fx:id="passwordField" promptText="Password" />
                        <TextField fx:id="visiblePasswordField" managed="false" visible="false" promptText="Password" />
                        <Button fx:id="showPasswordButton" styleClass="eye-button"
                                StackPane.alignment="CENTER_RIGHT"
                                onAction="#togglePasswordVisibility" text="👁" />
                    </children>
                </StackPane>
                <Label styleClass="hint" text="12+ characters. Use a mix of words, numbers or symbols." />

                <Label styleClass="hint"
                       text="By continuing, you agree to the Terms and Privacy notice. Your contact details are not shown publicly." />

                <Button styleClass="primary-button" defaultButton="true"
                        onAction="#btnContinueClicked" text="Continue to skills" />
            </children>
        </VBox>
    </content>
</ScrollPane>